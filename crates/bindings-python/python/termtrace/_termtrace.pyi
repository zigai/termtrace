from collections.abc import Mapping, Sequence
from typing import Self

def version() -> str: ...

class TermtraceError(Exception):
    kind: str
    """Machine-readable classification, e.g. `stale_state`, `control_timeout`, `wait_unsatisfied`."""
    code: str
    """The actor's rejection code when it rejected the request, otherwise `kind`."""
    effect: dict[str, str | int]
    """What the failed request did: `{"kind": "not_applied" | "partial" | "applied" | "unknown"}`,
    with `completed_atoms` for `partial`."""
    retry: str
    """Derived from `effect`: `new_request`, `same_request_id`, `inspect_first`, or `do_not_retry`."""
class StateGuardFailedError(TermtraceError): ...
class TimeoutError(TermtraceError): ...
class SessionNotFoundError(TermtraceError): ...
class IntegrityError(TermtraceError): ...

class ResolvedState:
    @property
    def hash(self) -> str: ...
    @property
    def text(self) -> str: ...
    @property
    def cursor_row(self) -> int: ...
    @property
    def cursor_col(self) -> int: ...

class ScreenFrame:
    @property
    def rows(self) -> int: ...
    @property
    def cols(self) -> int: ...
    @property
    def text(self) -> str: ...

class Screen:
    def frame(self) -> ScreenFrame: ...
    def text(self) -> str: ...
    def wait_for_text(self, pattern: str, timeout_secs: float | None = ...) -> ResolvedState: ...
    def wait_for_idle(self, timeout_secs: float | None = ...) -> ResolvedState: ...

class ActionBuilder:
    def if_state(self, state_hash: str) -> ActionBuilder: ...
    def send_text(self, text: str) -> ActionBuilder: ...
    def send_key(self, key: str) -> ActionBuilder: ...
    def send_bytes(self, bytes: bytes) -> ActionBuilder: ...
    def paste(self, text: str) -> ActionBuilder: ...
    def pace(self, delay_ms: int) -> ActionBuilder: ...
    def until_screen(self, pattern: str, timeout_secs: float | None = ...) -> ActionBuilder: ...
    def until_idle(
        self, stable_for_ms: int | None = ..., timeout_secs: float | None = ...
    ) -> ActionBuilder: ...
    def execute(self) -> ResolvedState | None: ...

class Session:
    @property
    def session_id(self) -> str: ...
    @property
    def path(self) -> str: ...
    def screen(self) -> Screen: ...
    def actions(self) -> ActionBuilder: ...
    def pointer_click(
        self, column: int, row: int, button: str | None = ..., strict: bool | None = ...
    ) -> None: ...
    def pointer_scroll(
        self, column: int, row: int, lines: int | None = ..., strict: bool | None = ...
    ) -> None: ...
    def pointer_focus(self, focused: bool, strict: bool | None = ...) -> None: ...
    def save(
        self,
        destination: str,
        formats: Sequence[str] | None = ...,
        state_hash: str | None = ...,
        include_hidden: bool | None = ...,
    ) -> str: ...
    def export_asciicast(self, output_path: str) -> None: ...
    def create_bundle(self, output_path: str) -> None: ...
    def diff(self, from_hash: str, to_hash: str) -> str: ...
    def read_output(
        self, offset: int | None = ..., limit: int | None = ...
    ) -> tuple[bytes, int, bool]: ...
    def wait_for_output(self, pattern: str, timeout_secs: float | None = ...) -> bool: ...
    def read_events(self, cursor: int | None = ..., limit: int | None = ...) -> str: ...
    def explain(self, target_hash: str | None = ..., context: int | None = ...) -> str: ...
    def diagnose(self, broad_change_percent: int | None = ...) -> str: ...
    def last_action(self, broad_change_percent: int | None = ...) -> str: ...
    def timeline_page(
        self,
        offset: int | None = ...,
        limit: int | None = ...,
        include_hidden: bool | None = ...,
        include_controls: bool | None = ...,
    ) -> str: ...

class Recording:
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: object,
    ) -> None: ...
    @property
    def session_id(self) -> str: ...
    @property
    def path(self) -> str: ...
    def is_active(self) -> bool: ...
    def screen(self) -> Screen: ...
    def actions(self) -> ActionBuilder: ...
    def session(self) -> Session: ...
    def pointer_click(
        self, column: int, row: int, button: str | None = ..., strict: bool | None = ...
    ) -> None: ...
    def pointer_scroll(
        self, column: int, row: int, lines: int | None = ..., strict: bool | None = ...
    ) -> None: ...
    def pointer_focus(self, focused: bool, strict: bool | None = ...) -> None: ...
    def save(
        self,
        destination: str,
        formats: Sequence[str] | None = ...,
        state_hash: str | None = ...,
        include_hidden: bool | None = ...,
    ) -> str: ...
    def read_output(
        self, offset: int | None = ..., limit: int | None = ...
    ) -> tuple[bytes, int, bool]: ...
    def wait_for_output(self, pattern: str, timeout_secs: float | None = ...) -> bool: ...
    def read_events(self, cursor: int | None = ..., limit: int | None = ...) -> str: ...
    def explain(self, target_hash: str | None = ..., context: int | None = ...) -> str: ...
    def diagnose(self, broad_change_percent: int | None = ...) -> str: ...
    def last_action(self, broad_change_percent: int | None = ...) -> str: ...
    def stop(self, timeout_secs: float | None = ...) -> None: ...
    def force_close(self) -> None: ...
    def detach(self) -> None: ...

class Termtrace:
    def __init__(self, binary: str | None = ..., evidence_root: str | None = ...) -> None: ...
    def record(
        self,
        command: Sequence[str],
        rows: int | None = ...,
        cols: int | None = ...,
        env: Mapping[str, str] | None = ...,
        cwd: str | None = ...,
    ) -> Recording: ...
    def attach(self, session_path: str) -> Session: ...
    def verify_bundle(
        self, bundle_path: str, source_session: str | None = ...
    ) -> bool: ...
    def verify_session(self, session_path: str, level: str | None = ...) -> str: ...
    def recover_session(self, session_path: str, destination: str) -> str: ...
    def registry_list(self, include_all: bool | None = ...) -> str: ...
    def registry_resolve(self, name: str) -> str | None: ...
    def registry_register(self, name: str, session_path: str) -> str: ...
    def registry_remove(self, name: str) -> bool: ...
    def registry_gc(
        self,
        older_than_days: int | None = ...,
        keep_latest: int | None = ...,
        max_completed_bytes: int | None = ...,
        apply: bool | None = ...,
    ) -> str: ...
    def tmux_bundle(self, manifest_path: str, destination: str) -> str: ...
    def tmux_verify_bundle(self, bundle_directory: str, manifest_path: str) -> bool: ...
    def probe_capabilities(self) -> str: ...

