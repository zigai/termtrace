{
  "name": "@termtrace/core",
  "version": "0.1.0",
  "description": "Native Node.js and TypeScript bindings for Termtrace terminal recording and semantic debugging",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./testing": "./testing.js",
    "./contracts": "./contracts.js"
  },
  "napi": {
    "name": "termtrace",
    "triples": {
      "default": true
    },
    "dtsHeaderFile": "dts-header.d.ts"
  },
  "scripts": {
    "build": "napi build --release",
    "build:debug": "napi build",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 18.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "types.d.ts",
    "termtrace.node",
    "contracts.js",
    "contracts.d.ts",
    "edit.js",
    "edit.d.ts",
    "locator.js",
    "original.js",
    "testing.js",
    "testing.d.ts"
  ]
}
