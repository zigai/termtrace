ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG TERMTRACE_BINARY=dist/termtrace
ARG GHOSTTY_DEB=dist/ghostty.deb
ARG SOURCE_REVISION
ARG TERMTRACE_VERSION
ARG BASE_IMAGE_DIGEST

LABEL org.opencontainers.image.title="termtrace native evidence environment" \
      org.opencontainers.image.version="${TERMTRACE_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.digest="${BASE_IMAGE_DIGEST}"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates dbus-x11 ffmpeg fonts-dejavu-core imagemagick jq tini util-linux xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY ${GHOSTTY_DEB} /tmp/ghostty.deb
RUN apt-get update \
    && apt-get install --yes --no-install-recommends /tmp/ghostty.deb \
    && rm -f /tmp/ghostty.deb \
    && rm -rf /var/lib/apt/lists/*

COPY ${TERMTRACE_BINARY} /usr/local/bin/termtrace
COPY packaging/native/entrypoint.sh /usr/local/bin/termtrace-native-entrypoint
RUN chmod 0555 /usr/local/bin/termtrace /usr/local/bin/termtrace-native-entrypoint \
    && termtrace doctor --require semantic

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/termtrace-native-entrypoint"]
CMD ["doctor", "--require", "semantic,native-screenshot,presentation"]
