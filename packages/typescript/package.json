{
  "name": "@termtrace/test",
  "version": "0.1.0",
  "description": "Strict TypeScript client for canonical terminal evidence",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "bin": {
    "termtrace": "bin/termtrace.js"
  },
  "files": ["bin", "lib"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@termtrace/cli-linux-arm64": "0.1.0",
    "@termtrace/cli-linux-x64": "0.1.0"
  },
  "license": "MIT"
}
