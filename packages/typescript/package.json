{
  "name": "@termtrace/test",
  "version": "0.1.0",
  "description": "Strict TypeScript client for canonical terminal evidence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/termtrace.git",
    "directory": "packages/typescript"
  },
  "bin": {
    "termtrace": "bin/termtrace.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "./lib/testing/vitest.js"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./vitest": {
      "types": "./lib/testing/vitest.d.ts",
      "import": "./lib/testing/vitest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test test",
    "test:vitest": "bun test test/nested-vitest.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "verify": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "json-schema-to-typescript": "15.0.4",
    "oxfmt": "^0.59.0",
    "oxlint": "1.79.0",
    "oxlint-rules": "0.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "vitest": ">=4.1.3 <5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@termtrace/cli-linux-arm64": "0.1.0",
    "@termtrace/cli-linux-x64": "0.1.0"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
