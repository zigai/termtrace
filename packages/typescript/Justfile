_:
    @just help

# List available commands
help:
    @just --list

# Regenerate typed protocol models
generate:
    bun run generate:protocol

# Build the distributable package
build:
    bun run build

# Format package sources
fmt:
    bun run format

# Check package sources for lint issues
lint:
    bun run lint

# Run strict static type checks
typecheck:
    bun run typecheck

# Run package tests
test:
    bun test

# Verify formatting without modifying files
format-check:
    bun run format:check

# Run all non-mutating quality checks
check:
    bun run check

# Apply automatic lint fixes and format sources
fix:
    bun run lint:fix
    bun run format
