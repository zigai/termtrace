_:
    @just help

# List available commands
help:
    @just --list

# Regenerate typed protocol models
generate:
    uv run --locked --group codegen python scripts/generate_protocol.py

# Format handwritten Python sources
fmt:
    uv run --locked --group dev ruff format termtrace scripts tests

# Check Python sources for lint issues
lint:
    uv run --locked --group dev ruff check termtrace scripts tests

# Run strict static type checks
typecheck:
    uv run --locked --group dev mypy termtrace tests

# Run the package tests
test:
    uv run --locked --group dev pytest -q tests

# Verify formatting without modifying files
format-check:
    uv run --locked --group dev ruff format --check termtrace scripts tests

# Run all non-mutating quality checks
check: format-check lint typecheck test

# Apply safe lint fixes and format sources
fix:
    uv run --locked --group dev ruff check --fix termtrace scripts tests
    uv run --locked --group dev ruff format termtrace scripts tests
