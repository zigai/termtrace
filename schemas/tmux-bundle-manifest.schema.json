{
  "$defs": {
    "ArtifactMember": {
      "additionalProperties": false,
      "description": "Whole-file integrity metadata embedded in a derived manifest.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the complete file.",
          "type": "string"
        },
        "byte_length": {
          "description": "Exact byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "Stable media type.",
          "type": "string"
        },
        "path": {
          "description": "Normalized relative path below the artifact directory.",
          "type": "string"
        },
        "relationship": {
          "description": "Relationship to the derivation.",
          "type": "string"
        },
        "schema_type": {
          "description": "Public schema identifier, when the file is structured data.",
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Sensitivity classification."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "TmuxBundleTrack": {
      "additionalProperties": false,
      "description": "One complete canonical track embedded in an aggregate tmux bundle.",
      "properties": {
        "canonical_session": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Exact source session path bytes."
        },
        "directory": {
          "description": "Relative directory containing a forensic Termtrace bundle.",
          "type": "string"
        },
        "pane_id": {
          "description": "Stable tmux pane ID for a pane track.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "`composite` or `pane`.",
          "type": "string"
        },
        "session_id": {
          "description": "Immutable canonical Termtrace session identity.",
          "format": "uuid",
          "type": "string"
        },
        "source_final_event_hash": {
          "description": "Final canonical event hash bound by the nested forensic bundle.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "session_id",
        "canonical_session",
        "directory",
        "source_final_event_hash"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/tmux-bundle-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Whole-file inventory for a complete aggregate tmux evidence bundle.",
  "properties": {
    "aggregate_manifest": {
      "$ref": "#/$defs/Base64Bytes",
      "description": "Exact source aggregate manifest path bytes."
    },
    "aggregate_manifest_blake3": {
      "description": "BLAKE3 of the complete source aggregate manifest.",
      "type": "string"
    },
    "format": {
      "description": "Stable format identifier.",
      "type": "string"
    },
    "members": {
      "description": "Whole-file inventory excluding this root manifest.",
      "items": {
        "$ref": "#/$defs/ArtifactMember"
      },
      "type": "array"
    },
    "recording_id": {
      "description": "Immutable aggregate recording identity.",
      "format": "uuid",
      "type": "string"
    },
    "recording_name": {
      "description": "Friendly aggregate recording name.",
      "type": "string"
    },
    "tracks": {
      "description": "Composite track followed by pane tracks in stable pane-ID order.",
      "items": {
        "$ref": "#/$defs/TmuxBundleTrack"
      },
      "type": "array"
    },
    "version": {
      "description": "Manifest schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "recording_id",
    "recording_name",
    "aggregate_manifest",
    "aggregate_manifest_blake3",
    "tracks",
    "members"
  ],
  "title": "TmuxBundleManifest",
  "type": "object"
}
