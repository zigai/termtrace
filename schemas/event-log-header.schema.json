{
  "$defs": {
    "TerminalColors": {
      "additionalProperties": false,
      "description": "Default terminal colors captured independently from application SGR output.",
      "properties": {
        "background": {
          "description": "Default background as red, green, and blue bytes.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "cursor": {
          "description": "Default cursor color when explicitly configured.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array",
            "null"
          ]
        },
        "foreground": {
          "description": "Default foreground as red, green, and blue bytes.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "palette": {
          "description": "Complete 256-color palette, or empty to use libghostty's built-in palette.",
          "items": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "source": {
          "description": "Provenance of the color values.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "foreground",
        "background",
        "palette"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/event-log-header.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metadata written before the first event.",
  "properties": {
    "colors": {
      "$ref": "#/$defs/TerminalColors",
      "description": "Default colors presented by the emulated terminal host."
    },
    "cols": {
      "description": "Initial terminal columns.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "format": {
      "description": "Constant format identifier.",
      "type": "string"
    },
    "pixel_height": {
      "description": "Initial terminal pixel height.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "pixel_width": {
      "description": "Initial terminal pixel width.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "rows": {
      "description": "Initial terminal rows.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "description": "Globally unique session identifier.",
      "format": "uuid",
      "type": "string"
    },
    "session_manifest_hash": {
      "description": "BLAKE3 of the exact immutable `session.json` bytes.",
      "type": "string"
    },
    "started_unix_ns": {
      "description": "Wall-clock Unix timestamp corresponding to monotonic time zero.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "term": {
      "description": "Terminal identity exposed to the child process.",
      "type": "string"
    },
    "version": {
      "description": "Schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "session_id",
    "session_manifest_hash",
    "started_unix_ns",
    "cols",
    "rows",
    "pixel_width",
    "pixel_height",
    "term",
    "colors"
  ],
  "title": "EventLogHeader",
  "type": "object"
}
