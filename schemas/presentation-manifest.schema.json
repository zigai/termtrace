{
  "$defs": {
    "AnnotationAnchor": {
      "description": "Stable annotation anchor vocabulary.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Top-left canvas corner.",
          "type": "string"
        },
        {
          "const": "top_right",
          "description": "Top-right canvas corner.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Bottom-left canvas corner.",
          "type": "string"
        },
        {
          "const": "bottom_right",
          "description": "Bottom-right canvas corner.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Canvas center.",
          "type": "string"
        }
      ]
    },
    "AnnotationPosition": {
      "additionalProperties": false,
      "description": "Named anchor plus signed pixel offset.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/AnnotationAnchor",
          "description": "Named canvas anchor."
        },
        "x": {
          "description": "Signed horizontal offset from the anchor.",
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "description": "Signed vertical offset from the anchor.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "anchor",
        "x",
        "y"
      ],
      "type": "object"
    },
    "AnnotationStyle": {
      "additionalProperties": false,
      "description": "Deterministic visible text style compiled to ASS.",
      "properties": {
        "background": {
          "description": "`#RRGGBB` background.",
          "type": "string"
        },
        "background_opacity": {
          "description": "Background opacity from zero through 255.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "border": {
          "description": "Border width in pixels.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "font_size": {
          "description": "Font size in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "foreground": {
          "description": "`#RRGGBB` foreground.",
          "type": "string"
        }
      },
      "required": [
        "font_size",
        "foreground",
        "background",
        "background_opacity",
        "border"
      ],
      "type": "object"
    },
    "ArtifactMember": {
      "additionalProperties": false,
      "description": "Whole-file integrity metadata embedded in a derived manifest.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the complete file.",
          "type": "string"
        },
        "byte_length": {
          "description": "Exact byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "Stable media type.",
          "type": "string"
        },
        "path": {
          "description": "Normalized relative path below the artifact directory.",
          "type": "string"
        },
        "relationship": {
          "description": "Relationship to the derivation.",
          "type": "string"
        },
        "schema_type": {
          "description": "Public schema identifier, when the file is structured data.",
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Sensitivity classification."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "CaptionLayout": {
      "description": "Placement of the per-clip caption preset.",
      "oneOf": [
        {
          "const": "footer",
          "description": "Extend the canvas below the native viewport.",
          "type": "string"
        },
        {
          "const": "overlay",
          "description": "Intentionally draw captions over source pixels.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Retain caption metadata without rendering it.",
          "type": "string"
        }
      ]
    },
    "ChangeMode": {
      "description": "Visible change-overlay mode.",
      "oneOf": [
        {
          "const": "outline",
          "description": "Outline changed cells or pixel regions.",
          "type": "string"
        },
        {
          "const": "dirty_rows",
          "description": "Shade rows reported dirty by semantic evidence.",
          "type": "string"
        },
        {
          "const": "bounding_box",
          "description": "Draw one minimal enclosing rectangle.",
          "type": "string"
        },
        {
          "const": "heatmap",
          "description": "Color changes by frequency or magnitude.",
          "type": "string"
        },
        {
          "const": "trail",
          "description": "Fade prior change regions across held frames.",
          "type": "string"
        },
        {
          "const": "side_diff",
          "description": "Add a side-by-side difference panel.",
          "type": "string"
        }
      ]
    },
    "ChangeRegion": {
      "additionalProperties": false,
      "description": "One nominal semantic-change region in source pixels.",
      "properties": {
        "height": {
          "description": "Region height.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Region width.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "Left source pixel.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Top source pixel.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "ChangeSource": {
      "description": "Truth source used by a change overlay.",
      "oneOf": [
        {
          "const": "semantic_cells",
          "description": "Nominally scheduled complete semantic-cell changes.",
          "type": "string"
        },
        {
          "const": "encoded_pixels",
          "description": "Actual decoded adjacent encoded-frame pixels.",
          "type": "string"
        }
      ]
    },
    "ChangeVisualization": {
      "additionalProperties": false,
      "description": "Explicit source and shape for per-frame change overlays.",
      "properties": {
        "hold_frames": {
          "default": 0,
          "description": "Number of output frames to retain a fading/held overlay.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/ChangeMode",
          "description": "Visible overlay form."
        },
        "pixel_threshold": {
          "description": "Pixel-difference threshold for encoded input, ignored for semantic input.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ChangeSource",
          "description": "Semantic scheduling or actual decoded adjacent pixels."
        }
      },
      "required": [
        "source",
        "mode"
      ],
      "type": "object"
    },
    "CursorMaskFrame": {
      "additionalProperties": false,
      "description": "One semantic cursor region masked on a mapped presentation frame.",
      "properties": {
        "evidence_level": {
          "description": "Honest semantic-to-native correlation level.",
          "type": "string"
        },
        "output_frame": {
          "description": "Presentation frame receiving the mask.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "region": {
          "$ref": "#/$defs/ChangeRegion",
          "description": "Nominal cursor pixel region."
        },
        "source_frame": {
          "description": "Native source frame selected by presentation mapping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state_hash": {
          "description": "Complete source semantic state hash.",
          "type": "string"
        },
        "state_id": {
          "description": "Latest presentation-eligible semantic state used for cursor geometry.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "output_frame",
        "source_frame",
        "state_id",
        "state_hash",
        "region",
        "evidence_level"
      ],
      "type": "object"
    },
    "MarkerRecord": {
      "additionalProperties": false,
      "description": "Canonical marker with duplicate and nominal-frame context.",
      "properties": {
        "event_seq": {
          "description": "Canonical event sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "description": "Marker label.",
          "type": "string"
        },
        "monotonic_ns": {
          "description": "Canonical session offset.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "native_evidence_level": {
          "description": "Honest native correlation level for the nominal frame.",
          "type": "string"
        },
        "nominal_frame": {
          "description": "Nominal source frame at the requested rate.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "occurrence_count": {
          "description": "Total occurrences of this label.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "occurrence_index": {
          "description": "One-based position of this marker among occurrences of the same label.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "presentation_eligible": {
          "description": "Whether an associated presentation-eligible semantic state exists.",
          "type": "boolean"
        },
        "semantic_state_hash": {
          "description": "Complete hash of the associated semantic state.",
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_state_id": {
          "description": "Latest presentation-eligible semantic state at or before the marker.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "event_seq",
        "monotonic_ns",
        "nominal_frame",
        "occurrence_count",
        "occurrence_index",
        "presentation_eligible",
        "native_evidence_level"
      ],
      "type": "object"
    },
    "NormalizedAnnotation": {
      "additionalProperties": false,
      "description": "One annotation resolved to a half-open output-frame interval.",
      "properties": {
        "annotation_index": {
          "description": "Stable caller annotation index.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "output_end_frame": {
          "description": "Exclusive presentation frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_start_frame": {
          "description": "Inclusive presentation frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/AnnotationPosition",
          "description": "Exact anchored placement."
        },
        "style": {
          "$ref": "#/$defs/AnnotationStyle",
          "description": "Visible text/background style."
        },
        "template": {
          "description": "Per-frame dynamic text template.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Literal text, when the track is static.",
          "type": [
            "string",
            "null"
          ]
        },
        "z_order": {
          "description": "Stable overlay ordering.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        }
      },
      "required": [
        "annotation_index",
        "output_start_frame",
        "output_end_frame",
        "position",
        "style",
        "z_order"
      ],
      "type": "object"
    },
    "NormalizedChangeFrame": {
      "additionalProperties": false,
      "description": "Semantic delta nominally scheduled onto presentation frames.",
      "properties": {
        "changed_regions": {
          "description": "Nominal changed-cell pixel regions.",
          "items": {
            "$ref": "#/$defs/ChangeRegion"
          },
          "type": "array"
        },
        "dirty_rows": {
          "description": "Rows reported dirty by the semantic engine.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "evidence_level": {
          "description": "Honest correlation level for this overlay input.",
          "type": "string"
        },
        "output_frames": {
          "description": "Output frames mapped to this source frame.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "source_frame": {
          "description": "Nominal native frame selected by clock arithmetic.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state_hash": {
          "description": "Complete semantic state hash.",
          "type": "string"
        },
        "state_id": {
          "description": "Semantic state that introduced the delta.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state_id",
        "state_hash",
        "source_frame",
        "output_frames",
        "changed_regions",
        "dirty_rows",
        "evidence_level"
      ],
      "type": "object"
    },
    "NormalizedClip": {
      "additionalProperties": false,
      "description": "Resolved clip and exact source/output frame decisions.",
      "properties": {
        "caption": {
          "description": "Optional caption retained as presentation content.",
          "type": [
            "string",
            "null"
          ]
        },
        "hold_frame_count": {
          "description": "Generated hold frame count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_end_frame": {
          "description": "Exclusive output frame after retiming and hold.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_start_frame": {
          "description": "First output frame for this clip.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retimed_frame_count": {
          "description": "Retimed source-derived frame count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_end_frame": {
          "description": "Exclusive source video frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_range": {
          "$ref": "#/$defs/SourceRange",
          "description": "Canonical half-open source interval."
        },
        "source_start_frame": {
          "description": "Inclusive source video frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "speed": {
          "$ref": "#/$defs/RationalSpeed",
          "description": "Exact playback speed."
        }
      },
      "required": [
        "source_range",
        "source_start_frame",
        "source_end_frame",
        "output_start_frame",
        "output_end_frame",
        "retimed_frame_count",
        "hold_frame_count",
        "speed"
      ],
      "type": "object"
    },
    "NormalizedSubtitle": {
      "additionalProperties": false,
      "description": "Validated subtitle input with stable content identity.",
      "properties": {
        "resource_hash": {
          "description": "BLAKE3 of the exact imported ASS bytes.",
          "type": "string"
        },
        "source_path": {
          "description": "Resolved caller resource path used for this export.",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "resource_hash"
      ],
      "type": "object"
    },
    "PixelTransform": {
      "description": "Explicit presentation-only pixel transform.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Replace cursor pixels during presentation composition.",
          "properties": {
            "transform": {
              "const": "cursor_mask",
              "type": "string"
            }
          },
          "required": [
            "transform"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Crop to an exact source rectangle.",
          "properties": {
            "height": {
              "description": "Rectangle height.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "transform": {
              "const": "crop",
              "type": "string"
            },
            "width": {
              "description": "Rectangle width.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "description": "Left source pixel.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "description": "Top source pixel.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "transform",
            "x",
            "y",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Scale by one exact rational factor.",
          "properties": {
            "denominator": {
              "description": "Scale denominator.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "numerator": {
              "description": "Scale numerator.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "transform": {
              "const": "zoom",
              "type": "string"
            }
          },
          "required": [
            "transform",
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Resize to an exact presentation canvas.",
          "properties": {
            "height": {
              "description": "Output height in pixels.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "transform": {
              "const": "resize",
              "type": "string"
            },
            "width": {
              "description": "Output width in pixels.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "transform",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Draw a visibly labeled rectangular callout.",
          "properties": {
            "height": {
              "description": "Callout height.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "label": {
              "description": "Optional visible label.",
              "type": [
                "string",
                "null"
              ]
            },
            "transform": {
              "const": "callout",
              "type": "string"
            },
            "width": {
              "description": "Callout width.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "description": "Left callout pixel.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "description": "Top callout pixel.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "transform",
            "x",
            "y",
            "width",
            "height"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationDelivery": {
      "additionalProperties": false,
      "description": "Delivery codec and pixel-format contract.",
      "properties": {
        "codec": {
          "description": "Stable delivery codec name.",
          "type": "string"
        },
        "crf": {
          "default": 23,
          "description": "libx264 constant-rate-factor quality.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "encoder_preset": {
          "default": "medium",
          "description": "libx264 speed/compression preset.",
          "type": "string"
        },
        "pixel_format": {
          "description": "Stable output pixel format.",
          "type": "string"
        }
      },
      "required": [
        "codec",
        "pixel_format"
      ],
      "type": "object"
    },
    "PresentationLayout": {
      "additionalProperties": false,
      "description": "Canvas layout for caption presets.",
      "properties": {
        "branding": {
          "description": "Optional caller-owned branding label.",
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "$ref": "#/$defs/CaptionLayout",
          "description": "Caption placement, with footer preserving terminal pixels."
        }
      },
      "required": [
        "caption"
      ],
      "type": "object"
    },
    "PresentationPlan": {
      "additionalProperties": false,
      "description": "Dry-run output binding a normalized edit to immutable visual evidence.",
      "properties": {
        "annotations": {
          "description": "Annotation tracks normalized onto the output frame timeline.",
          "items": {
            "$ref": "#/$defs/NormalizedAnnotation"
          },
          "type": "array"
        },
        "change_algorithm": {
          "description": "Stable change-overlay implementation and truth description.",
          "type": [
            "string",
            "null"
          ]
        },
        "change_frames": {
          "description": "Semantic deltas scheduled onto mapped presentation frames.",
          "items": {
            "$ref": "#/$defs/NormalizedChangeFrame"
          },
          "type": "array"
        },
        "change_visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeVisualization"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit per-frame change overlay policy."
        },
        "clips": {
          "description": "Caller-ordered resolved clips.",
          "items": {
            "$ref": "#/$defs/NormalizedClip"
          },
          "type": "array"
        },
        "cursor_masks": {
          "description": "Cursor regions nominally masked from presentation pixels.",
          "items": {
            "$ref": "#/$defs/CursorMaskFrame"
          },
          "type": "array"
        },
        "delivery": {
          "$ref": "#/$defs/PresentationDelivery",
          "description": "Delivery encoding contract."
        },
        "edit_plan_hash": {
          "description": "BLAKE3 of canonical input edit-plan JSON.",
          "type": "string"
        },
        "fps": {
          "description": "Native capture or generated semantic source frame rate.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "layout": {
          "$ref": "#/$defs/PresentationLayout",
          "description": "Presentation canvas and caption policy."
        },
        "markers": {
          "description": "Canonical markers mapped onto native source frames.",
          "items": {
            "$ref": "#/$defs/MarkerRecord"
          },
          "type": "array"
        },
        "output_frame_count": {
          "description": "Total output frames after retiming and holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_height": {
          "description": "Final presentation canvas height after footer and transforms.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "output_width": {
          "description": "Final presentation canvas width after side panels and transforms.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "render_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoRenderConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effective user-facing render settings retained from the facade."
        },
        "source": {
          "$ref": "#/$defs/PresentationSource",
          "description": "Explicit immutable visual source; native remains the default request."
        },
        "source_geometry": {
          "$ref": "#/$defs/TerminalGeometryReport",
          "description": "Measured native or deterministic semantic grid and cell geometry."
        },
        "source_height": {
          "description": "Visual source height in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "source_width": {
          "description": "Visual source width in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "subtitles": {
          "description": "Validated caller-authored subtitle resources.",
          "items": {
            "$ref": "#/$defs/NormalizedSubtitle"
          },
          "type": "array"
        },
        "transforms": {
          "description": "Ordered visibly labeled pixel transforms.",
          "items": {
            "$ref": "#/$defs/PixelTransform"
          },
          "type": "array"
        },
        "version": {
          "description": "Presentation format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "edit_plan_hash",
        "source",
        "fps",
        "source_width",
        "source_height",
        "source_geometry",
        "output_width",
        "output_height",
        "clips",
        "markers",
        "annotations",
        "subtitles",
        "change_frames",
        "cursor_masks",
        "layout",
        "delivery",
        "transforms",
        "output_frame_count"
      ],
      "type": "object"
    },
    "PresentationSource": {
      "description": "Immutable visual source selected for one presentation plan.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Actual pixels from a verified native Ghostty capture.",
          "properties": {
            "kind": {
              "const": "native",
              "type": "string"
            },
            "video": {
              "description": "Lossless native source video.",
              "type": "string"
            },
            "video_hash": {
              "description": "BLAKE3 of the native source video.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "video",
            "video_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Deterministic generated pixels from canonical semantic replay.",
          "properties": {
            "kind": {
              "const": "semantic",
              "type": "string"
            },
            "plan": {
              "$ref": "#/$defs/SemanticVideoSourcePlan",
              "description": "Complete semantic source plan."
            }
          },
          "required": [
            "kind",
            "plan"
          ],
          "type": "object"
        }
      ]
    },
    "RationalSpeed": {
      "additionalProperties": false,
      "description": "Exact positive playback speed numerator/denominator.",
      "properties": {
        "denominator": {
          "description": "Source-time multiplier denominator.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "numerator": {
          "description": "Source-time multiplier numerator.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "SemanticVideoCanvas": {
      "additionalProperties": false,
      "description": "Fixed canvas used for every frame of one semantic video source.",
      "properties": {
        "cell_height": {
          "description": "Deterministic semantic cell height.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cell_width": {
          "description": "Deterministic semantic cell width.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cols": {
          "description": "Largest terminal column count in the source execution.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "description": "Encoded source height.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "policy": {
          "description": "Stable resize/canvas policy identifier.",
          "type": "string"
        },
        "rows": {
          "description": "Largest terminal row count in the source execution.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Encoded source width.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows",
        "cell_width",
        "cell_height",
        "width",
        "height",
        "policy"
      ],
      "type": "object"
    },
    "SemanticVideoSourcePlan": {
      "additionalProperties": false,
      "description": "Immutable semantic source description resolved during presentation planning.",
      "properties": {
        "canvas": {
          "$ref": "#/$defs/SemanticVideoCanvas",
          "description": "Fixed source canvas."
        },
        "end_monotonic_ns": {
          "description": "Inclusive completed-session endpoint used for the final frame hold.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "font_family": {
          "description": "Bundled deterministic font family.",
          "type": "string"
        },
        "font_hash": {
          "description": "BLAKE3 identity of the bundled font bytes.",
          "type": "string"
        },
        "fps": {
          "description": "Constant semantic source frame rate.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "frame_count": {
          "description": "Exact source frame count, including one final semantic-state frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "renderer": {
          "description": "Semantic renderer identity.",
          "type": "string"
        },
        "scheduling_policy": {
          "description": "Stable state-to-frame scheduling policy.",
          "type": "string"
        },
        "session": {
          "description": "Canonical session path.",
          "type": "string"
        },
        "session_id": {
          "description": "Canonical session identity.",
          "format": "uuid",
          "type": "string"
        },
        "source_event_hash": {
          "description": "Terminal canonical event hash.",
          "type": "string"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source-time origin.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Source-plan schema version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session",
        "session_id",
        "source_event_hash",
        "start_monotonic_ns",
        "end_monotonic_ns",
        "fps",
        "frame_count",
        "canvas",
        "renderer",
        "font_family",
        "font_hash",
        "scheduling_policy"
      ],
      "type": "object"
    },
    "SourceRange": {
      "description": "A non-empty half-open interval on the canonical monotonic timeline.",
      "properties": {
        "end_monotonic_ns": {
          "description": "Exclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_monotonic_ns",
        "end_monotonic_ns"
      ],
      "type": "object"
    },
    "TerminalGeometryReport": {
      "description": "Geometry reported by a live terminal through XTWINOPS queries.",
      "properties": {
        "cell_height": {
          "description": "Height of one rendered cell in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cell_width": {
          "description": "Width of one rendered cell in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cols": {
          "description": "Terminal columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Terminal rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text_height": {
          "description": "Height of the complete text area in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text_width": {
          "description": "Width of the complete text area in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows",
        "cell_width",
        "cell_height",
        "text_width",
        "text_height"
      ],
      "type": "object"
    },
    "VideoRenderConfig": {
      "additionalProperties": false,
      "description": "Effective user-facing video facade settings.",
      "properties": {
        "cursor_style": {
          "description": "Effective cursor presentation style.",
          "type": "string"
        },
        "end_marker": {
          "description": "Optional exclusive marker.",
          "type": [
            "string",
            "null"
          ]
        },
        "fps": {
          "description": "Effective output frame rate.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "hold_end_ms": {
          "description": "Generated closing hold.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hold_start_ms": {
          "description": "Generated opening hold.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "idle_threshold_ms": {
          "description": "Idle gap threshold used by trimming.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "preset": {
          "description": "Named delivery preset.",
          "type": "string"
        },
        "renderer": {
          "description": "Requested renderer without fallback.",
          "type": "string"
        },
        "resolution": {
          "description": "Exact requested output resolution.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "scale": {
          "description": "Requested integer scale factor.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start_marker": {
          "description": "Optional inclusive marker.",
          "type": [
            "string",
            "null"
          ]
        },
        "trim_idle": {
          "description": "Whether long gaps without child output were removed.",
          "type": "boolean"
        }
      },
      "required": [
        "preset",
        "renderer",
        "fps",
        "trim_idle",
        "hold_start_ms",
        "hold_end_ms",
        "cursor_style"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/presentation-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Integrity and tool provenance for an edited presentation.",
  "properties": {
    "ffmpeg_arguments": {
      "description": "Exact direct-process FFmpeg argument vector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ffmpeg_version": {
      "description": "First line of the exact FFmpeg build used.",
      "type": "string"
    },
    "members": {
      "description": "Whole-file integrity metadata for every non-manifest member.",
      "items": {
        "$ref": "#/$defs/ArtifactMember"
      },
      "type": "array"
    },
    "output_probe": {
      "description": "Parsed FFprobe delivery-video evidence."
    },
    "output_video_hash": {
      "description": "BLAKE3 of the encoded delivery video.",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/PresentationPlan",
      "description": "Exact resolved plan."
    },
    "source_truth_layer": {
      "description": "Truth layer used as presentation input.",
      "type": "string"
    },
    "truth_layer": {
      "description": "Product truth layer, distinct from immutable native evidence.",
      "type": "string"
    },
    "version": {
      "description": "Presentation format version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "plan",
    "ffmpeg_version",
    "ffmpeg_arguments",
    "output_probe",
    "truth_layer",
    "source_truth_layer",
    "output_video_hash",
    "members"
  ],
  "title": "PresentationManifest",
  "type": "object"
}
