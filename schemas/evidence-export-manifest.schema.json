{
  "$defs": {
    "ArtifactMember": {
      "additionalProperties": false,
      "description": "Whole-file integrity metadata embedded in a derived manifest.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the complete file.",
          "type": "string"
        },
        "byte_length": {
          "description": "Exact byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "Stable media type.",
          "type": "string"
        },
        "path": {
          "description": "Normalized relative path below the artifact directory.",
          "type": "string"
        },
        "relationship": {
          "description": "Relationship to the derivation.",
          "type": "string"
        },
        "schema_type": {
          "description": "Public schema identifier, when the file is structured data.",
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Sensitivity classification."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "BundleProfile": {
      "description": "Fixed bundle content policy.",
      "oneOf": [
        {
          "const": "screen",
          "description": "Latest screen observation without canonical raw events.",
          "type": "string"
        },
        {
          "const": "debug",
          "description": "Screen plus metadata-only canonical event projections and verification.",
          "type": "string"
        },
        {
          "const": "forensic",
          "description": "Complete top-level canonical session payload plus verification.",
          "type": "string"
        }
      ]
    },
    "PathValue": {
      "anyOf": [
        {
          "description": "A path that is valid UTF-8.",
          "type": "string"
        },
        {
          "description": "A path whose bytes are not valid UTF-8.",
          "properties": {
            "base64": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact path bytes encoded as Base64."
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        }
      ],
      "description": "One exact filesystem path in text output."
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/evidence-export-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top-level whole-file bundle manifest.",
  "properties": {
    "canonical_session": {
      "$ref": "#/$defs/PathValue",
      "description": "Exact source session path bytes."
    },
    "format": {
      "description": "Stable manifest format.",
      "type": "string"
    },
    "includes_canonical_evidence": {
      "description": "Whether canonical raw evidence is included.",
      "type": "boolean"
    },
    "members": {
      "description": "Whole-file inventory; unmanifested payloads are invalid.",
      "items": {
        "$ref": "#/$defs/ArtifactMember"
      },
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/BundleProfile",
      "description": "Selected policy."
    },
    "session_id": {
      "description": "Immutable canonical session identity.",
      "format": "uuid",
      "type": "string"
    },
    "source_final_event_hash": {
      "description": "Final canonical event hash.",
      "type": "string"
    },
    "version": {
      "description": "Manifest schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "profile",
    "session_id",
    "canonical_session",
    "source_final_event_hash",
    "includes_canonical_evidence",
    "members"
  ],
  "title": "BundleManifest",
  "type": "object"
}
