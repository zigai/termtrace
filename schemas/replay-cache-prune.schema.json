{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "ExactPath": {
      "allOf": [
        {
          "$ref": "#/$defs/PathValue"
        }
      ],
      "x-termtrace-path": true
    },
    "PathValue": {
      "anyOf": [
        {
          "description": "A path that is valid UTF-8.",
          "type": "string"
        },
        {
          "description": "A path whose bytes are not valid UTF-8.",
          "properties": {
            "base64": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact path bytes encoded as Base64."
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        }
      ],
      "description": "One exact filesystem path in text output."
    },
    "ReplayCacheStatus": {
      "additionalProperties": false,
      "description": "Bounded disposable replay-cache inventory for one canonical session.",
      "properties": {
        "compressed_bytes": {
          "description": "Total compressed bytes retained.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "directory": {
          "$ref": "#/$defs/ExactPath",
          "description": "Cache directory inside the canonical session."
        },
        "entries": {
          "description": "Number of checkpoint files currently retained.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_compressed_bytes": {
          "description": "Automatic per-session compressed-byte limit.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_entries": {
          "description": "Automatic per-session checkpoint limit.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "directory",
        "entries",
        "compressed_bytes",
        "maximum_entries",
        "maximum_compressed_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/replay-cache-prune.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result of explicitly deleting disposable replay checkpoints.",
  "properties": {
    "directory": {
      "$ref": "#/$defs/ExactPath",
      "description": "Cache directory considered."
    },
    "remaining": {
      "$ref": "#/$defs/ReplayCacheStatus",
      "description": "Inventory remaining after pruning."
    },
    "removed_bytes": {
      "description": "Compressed bytes removed.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "removed_entries": {
      "description": "Files removed.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "directory",
    "removed_entries",
    "removed_bytes",
    "remaining"
  ],
  "title": "ReplayCachePruneReport",
  "type": "object"
}
