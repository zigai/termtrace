{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "TmuxPaneTrack": {
      "description": "One immutable pane recording incarnation linked to an aggregate.",
      "properties": {
        "linked_unix_ns": {
          "description": "Time this incarnation was first linked to the aggregate.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane_id": {
          "description": "Stable pane ID; a pane may have arbitrarily many recording incarnations.",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Exact canonical session path."
        },
        "session_id": {
          "description": "Immutable canonical recording identity.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "pane_id",
        "session_id",
        "session",
        "linked_unix_ns"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/tmux-track-catalog-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One bounded-page result from the complete recording inventory.",
  "properties": {
    "completed": {
      "description": "Whether canonical completion was observed.",
      "type": "boolean"
    },
    "sequence": {
      "description": "Lifecycle sequence that first linked this incarnation.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "track": {
      "$ref": "#/$defs/TmuxPaneTrack",
      "description": "Immutable pane recording identity and path."
    }
  },
  "required": [
    "sequence",
    "track",
    "completed"
  ],
  "title": "TmuxTrackCatalogEntry",
  "type": "object"
}
