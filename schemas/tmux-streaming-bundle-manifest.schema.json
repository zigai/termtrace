{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/tmux-streaming-bundle-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded manifest for an aggregate export with a streamed track inventory.",
  "properties": {
    "aggregate_manifest": {
      "$ref": "#/$defs/Base64Bytes",
      "description": "Exact source aggregate manifest path bytes."
    },
    "aggregate_manifest_blake3": {
      "description": "BLAKE3 of the caller-owned aggregate snapshot.",
      "type": "string"
    },
    "format": {
      "description": "Stable format identifier.",
      "type": "string"
    },
    "recording_id": {
      "description": "Immutable aggregate recording identity.",
      "format": "uuid",
      "type": "string"
    },
    "recording_name": {
      "description": "Friendly recording name.",
      "type": "string"
    },
    "track_count": {
      "description": "Number of nested forensic bundles, including the composite.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "track_inventory_blake3": {
      "description": "BLAKE3 of tracks.jsonl; each row is a TmuxBundleTrack.",
      "type": "string"
    },
    "track_inventory_bytes": {
      "description": "Exact byte count of tracks.jsonl.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "description": "Manifest schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "recording_id",
    "recording_name",
    "aggregate_manifest",
    "aggregate_manifest_blake3",
    "track_count",
    "track_inventory_bytes",
    "track_inventory_blake3"
  ],
  "title": "TmuxStreamingBundleManifest",
  "type": "object"
}
