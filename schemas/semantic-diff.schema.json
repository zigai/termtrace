{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "CellChange": {
      "additionalProperties": false,
      "description": "One changed viewport cell.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete later cell, absent outside later geometry."
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete earlier cell, absent outside earlier geometry."
        },
        "column": {
          "description": "Zero-based column.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "column"
      ],
      "type": "object"
    },
    "CellState": {
      "description": "One visible cell in a semantic snapshot.",
      "properties": {
        "column": {
          "description": "Zero-based column.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "grapheme": {
          "description": "Full UTF-8 grapheme cluster; empty for a blank cell.",
          "type": "string"
        },
        "resolved_background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved explicit background, before terminal-default fallback."
        },
        "resolved_foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved explicit foreground, before terminal-default fallback."
        },
        "selected": {
          "description": "Whether the cell is selected.",
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/CellStyle",
          "description": "Visual style."
        }
      },
      "required": [
        "column",
        "grapheme",
        "style",
        "selected"
      ],
      "type": "object"
    },
    "CellStyle": {
      "description": "Complete style attached to one terminal cell.",
      "properties": {
        "background": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Background color source."
        },
        "blink": {
          "description": "Blink attribute.",
          "type": "boolean"
        },
        "bold": {
          "description": "Bold attribute.",
          "type": "boolean"
        },
        "faint": {
          "description": "Faint attribute.",
          "type": "boolean"
        },
        "foreground": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Foreground color source."
        },
        "inverse": {
          "description": "Inverse-video attribute.",
          "type": "boolean"
        },
        "invisible": {
          "description": "Invisible attribute.",
          "type": "boolean"
        },
        "italic": {
          "description": "Italic attribute.",
          "type": "boolean"
        },
        "overline": {
          "description": "Overline attribute.",
          "type": "boolean"
        },
        "strikethrough": {
          "description": "Strikethrough attribute.",
          "type": "boolean"
        },
        "underline": {
          "description": "Upstream SGR underline value (`0` through `5`).",
          "format": "int32",
          "type": "integer"
        },
        "underline_color": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Underline color source."
        }
      },
      "required": [
        "foreground",
        "background",
        "underline_color",
        "bold",
        "italic",
        "faint",
        "blink",
        "inverse",
        "invisible",
        "strikethrough",
        "overline",
        "underline"
      ],
      "type": "object"
    },
    "ColorSpec": {
      "description": "Cell color source before default-color fallback.",
      "oneOf": [
        {
          "description": "No explicit color.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Index into the active 256-color palette.",
          "properties": {
            "kind": {
              "const": "palette",
              "type": "string"
            },
            "value": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Explicit true color.",
          "properties": {
            "kind": {
              "const": "rgb",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ColorState": {
      "description": "Active terminal colors.",
      "properties": {
        "background": {
          "$ref": "#/$defs/Rgb",
          "description": "Default/current background."
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit cursor color."
        },
        "foreground": {
          "$ref": "#/$defs/Rgb",
          "description": "Default/current foreground."
        },
        "palette": {
          "description": "Active 256-color palette.",
          "items": {
            "$ref": "#/$defs/Rgb"
          },
          "type": "array"
        }
      },
      "required": [
        "background",
        "foreground",
        "palette"
      ],
      "type": "object"
    },
    "CursorState": {
      "description": "Cursor state at one semantic boundary.",
      "properties": {
        "blinking": {
          "description": "Blink mode.",
          "type": "boolean"
        },
        "column": {
          "description": "Viewport column when available.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "in_viewport": {
          "description": "Whether the cursor lies in the viewport.",
          "type": "boolean"
        },
        "row": {
          "description": "Viewport row when available.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/CursorStyle",
          "description": "Visual shape."
        },
        "visible": {
          "description": "Visibility mode.",
          "type": "boolean"
        },
        "wide_tail": {
          "description": "Whether the cursor is on a wide-character tail.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "visible",
        "blinking",
        "in_viewport",
        "style"
      ],
      "type": "object"
    },
    "CursorStyle": {
      "description": "Cursor visual style.",
      "oneOf": [
        {
          "const": "bar",
          "description": "Vertical bar.",
          "type": "string"
        },
        {
          "const": "block",
          "description": "Filled block.",
          "type": "string"
        },
        {
          "const": "underline",
          "description": "Underline.",
          "type": "string"
        },
        {
          "const": "hollow_block",
          "description": "Hollow block.",
          "type": "string"
        }
      ]
    },
    "DiffEndpoint": {
      "additionalProperties": false,
      "description": "Stable identity for one semantic diff endpoint.",
      "properties": {
        "event_seq": {
          "description": "Responsible event sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ghostty_dirty": {
          "$ref": "#/$defs/DirtyState",
          "description": "Ghostty dirty classification at this endpoint."
        },
        "ghostty_dirty_rows": {
          "description": "Rows Ghostty marked dirty at this endpoint.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "monotonic_ns": {
          "description": "Session-monotonic timestamp.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "point": {
          "$ref": "#/$defs/StatePoint",
          "description": "Requested endpoint selector."
        },
        "presented": {
          "description": "Whether the state was presentation eligible.",
          "type": "boolean"
        },
        "state_hash": {
          "description": "Complete semantic state hash.",
          "type": "string"
        },
        "state_id": {
          "description": "Dense semantic state identifier.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "point",
        "state_id",
        "state_hash",
        "monotonic_ns",
        "presented",
        "ghostty_dirty",
        "ghostty_dirty_rows"
      ],
      "type": "object"
    },
    "DirtyState": {
      "description": "Global render dirtiness reported by Ghostty.",
      "oneOf": [
        {
          "const": "clean",
          "description": "No visual change.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "One or more rows changed.",
          "type": "string"
        },
        {
          "const": "full",
          "description": "Full redraw required.",
          "type": "string"
        }
      ]
    },
    "ModeState": {
      "description": "Terminal modes relevant to presentation and input.",
      "properties": {
        "alternate_screen": {
          "description": "Any alternate-screen mode.",
          "type": "boolean"
        },
        "bracketed_paste": {
          "description": "DEC bracketed-paste mode 2004.",
          "type": "boolean"
        },
        "synchronized_output": {
          "description": "DEC synchronized-output mode 2026.",
          "type": "boolean"
        },
        "values": {
          "description": "Complete stable inventory of known ANSI and DEC modes.",
          "items": {
            "$ref": "#/$defs/TerminalMode"
          },
          "type": "array"
        },
        "wraparound": {
          "description": "DEC auto-wrap mode 7.",
          "type": "boolean"
        }
      },
      "required": [
        "synchronized_output",
        "alternate_screen",
        "wraparound",
        "bracketed_paste",
        "values"
      ],
      "type": "object"
    },
    "Rgb": {
      "description": "RGB color independent of libghostty's unstable ABI.",
      "properties": {
        "b": {
          "description": "Blue channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "g": {
          "description": "Green channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "r": {
          "description": "Red channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "r",
        "g",
        "b"
      ],
      "type": "object"
    },
    "RowChange": {
      "additionalProperties": false,
      "description": "Changed cells for one viewport row.",
      "properties": {
        "cells": {
          "description": "Complete semantic cell changes.",
          "items": {
            "$ref": "#/$defs/CellChange"
          },
          "type": "array"
        },
        "row": {
          "description": "Zero-based row.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "row",
        "cells"
      ],
      "type": "object"
    },
    "StatePoint": {
      "description": "Shared state selection vocabulary.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Latest presentation-eligible state.",
          "properties": {
            "selector": {
              "const": "latest_presented",
              "type": "string"
            }
          },
          "required": [
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact semantic state identifier.",
          "properties": {
            "selector": {
              "const": "state_id",
              "type": "string"
            },
            "state_id": {
              "description": "Exact semantic state identifier.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "selector",
            "state_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact content-addressed semantic state hash.",
          "properties": {
            "selector": {
              "const": "state_hash",
              "type": "string"
            },
            "state_hash": {
              "description": "BLAKE3 hash of the complete normalized semantic state.",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "state_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Latest state at or before an event sequence.",
          "properties": {
            "event_seq": {
              "description": "Canonical event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "selector": {
              "const": "event_seq",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "event_seq"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Latest state at or before a session-monotonic timestamp.",
          "properties": {
            "monotonic_ns": {
              "description": "Session-monotonic nanoseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "selector": {
              "const": "monotonic_ns",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "monotonic_ns"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "State at a uniquely named marker.",
          "properties": {
            "label": {
              "description": "Unique marker label.",
              "type": "string"
            },
            "selector": {
              "const": "marker",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "TerminalMetadata": {
      "description": "Terminal metadata controlled by OSC sequences.",
      "properties": {
        "title": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Raw title bytes."
        },
        "working_directory": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Raw working-directory bytes."
        }
      },
      "required": [
        "title",
        "working_directory"
      ],
      "type": "object"
    },
    "TerminalMode": {
      "description": "One ANSI or DEC mode value.",
      "properties": {
        "ansi": {
          "description": "`true` for ANSI mode, `false` for DEC-private mode.",
          "type": "boolean"
        },
        "enabled": {
          "description": "Current set/reset value.",
          "type": "boolean"
        },
        "number": {
          "description": "Numeric mode identifier.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "number",
        "ansi",
        "enabled"
      ],
      "type": "object"
    },
    "ValueChange": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "description": "Value at the later endpoint.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "before": {
          "description": "Value at the earlier endpoint.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange2": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "$ref": "#/$defs/CursorState",
          "description": "Value at the later endpoint."
        },
        "before": {
          "$ref": "#/$defs/CursorState",
          "description": "Value at the earlier endpoint."
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange3": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "$ref": "#/$defs/ModeState",
          "description": "Value at the later endpoint."
        },
        "before": {
          "$ref": "#/$defs/ModeState",
          "description": "Value at the earlier endpoint."
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange4": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "$ref": "#/$defs/ColorState",
          "description": "Value at the later endpoint."
        },
        "before": {
          "$ref": "#/$defs/ColorState",
          "description": "Value at the earlier endpoint."
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange5": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "$ref": "#/$defs/CellStyle",
          "description": "Value at the later endpoint."
        },
        "before": {
          "$ref": "#/$defs/CellStyle",
          "description": "Value at the earlier endpoint."
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange6": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "$ref": "#/$defs/TerminalMetadata",
          "description": "Value at the later endpoint."
        },
        "before": {
          "$ref": "#/$defs/TerminalMetadata",
          "description": "Value at the earlier endpoint."
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "ValueChange7": {
      "additionalProperties": false,
      "description": "Before/after values for one changed semantic property.",
      "properties": {
        "after": {
          "description": "Value at the later endpoint.",
          "type": "boolean"
        },
        "before": {
          "description": "Value at the earlier endpoint.",
          "type": "boolean"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/semantic-diff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete semantic difference between two canonical state points.",
  "properties": {
    "active_style": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange5"
        },
        {
          "type": "null"
        }
      ],
      "description": "Active SGR style change."
    },
    "changed": {
      "description": "Whether any normalized semantic or presentation value changed.",
      "type": "boolean"
    },
    "colors": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange4"
        },
        {
          "type": "null"
        }
      ],
      "description": "Palette/default-color change."
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange2"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cursor change."
    },
    "from": {
      "$ref": "#/$defs/DiffEndpoint",
      "description": "Earlier endpoint identity and provenance."
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange"
        },
        {
          "type": "null"
        }
      ],
      "description": "Geometry change."
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange6"
        },
        {
          "type": "null"
        }
      ],
      "description": "OSC metadata change."
    },
    "modes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange3"
        },
        {
          "type": "null"
        }
      ],
      "description": "Terminal mode change."
    },
    "presented": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueChange7"
        },
        {
          "type": "null"
        }
      ],
      "description": "Presentation-eligibility change."
    },
    "rows": {
      "description": "Minimal changed semantic cells grouped by row.",
      "items": {
        "$ref": "#/$defs/RowChange"
      },
      "type": "array"
    },
    "to": {
      "$ref": "#/$defs/DiffEndpoint",
      "description": "Later endpoint identity and provenance."
    }
  },
  "required": [
    "from",
    "to",
    "changed",
    "rows"
  ],
  "title": "SemanticDiff",
  "type": "object"
}
