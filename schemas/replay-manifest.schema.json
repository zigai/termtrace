{
  "$defs": {
    "SourceRange": {
      "description": "A non-empty half-open interval on the canonical monotonic timeline.",
      "properties": {
        "end_monotonic_ns": {
          "description": "Exclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_monotonic_ns",
        "end_monotonic_ns"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/replay-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Manifest committed with derived replay artifacts.",
  "properties": {
    "files": {
      "description": "Relative artifact paths.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "final_state_hash": {
      "description": "Semantic state hash at the selected interval's end.",
      "type": "string"
    },
    "ghostty_revision": {
      "description": "Exact Ghostty source revision.",
      "type": "string"
    },
    "session_id": {
      "description": "Source session identifier.",
      "format": "uuid",
      "type": "string"
    },
    "source_event_hash": {
      "description": "Source event-log terminal hash.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "Selected half-open source interval, absent for a full-session index."
    },
    "state_count": {
      "description": "Number of distinct semantic states.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "description": "Artifact schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "ghostty_revision",
    "state_count",
    "final_state_hash",
    "files"
  ],
  "title": "ReplayManifest",
  "type": "object"
}
