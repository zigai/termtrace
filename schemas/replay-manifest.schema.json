{
  "$defs": {
    "ArtifactMember": {
      "additionalProperties": false,
      "description": "Whole-file integrity metadata embedded in a derived manifest.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the complete file.",
          "type": "string"
        },
        "byte_length": {
          "description": "Exact byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "Stable media type.",
          "type": "string"
        },
        "path": {
          "description": "Normalized relative path below the artifact directory.",
          "type": "string"
        },
        "relationship": {
          "description": "Relationship to the derivation.",
          "type": "string"
        },
        "schema_type": {
          "description": "Public schema identifier, when the file is structured data.",
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Sensitivity classification."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "SourceRange": {
      "description": "A non-empty half-open interval on the canonical monotonic timeline.",
      "properties": {
        "end_monotonic_ns": {
          "description": "Exclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_monotonic_ns",
        "end_monotonic_ns"
      ],
      "type": "object"
    },
    "StateSelection": {
      "description": "Semantic states retained in one derived index.",
      "oneOf": [
        {
          "const": "all",
          "description": "Retain every distinct state, including synchronized-output internals.",
          "type": "string"
        },
        {
          "const": "presented",
          "description": "Retain only states eligible for presentation by a native terminal.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/replay-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Manifest committed with derived replay artifacts.",
  "properties": {
    "final_retained_state_hash": {
      "description": "Hash of the final state retained in filtered artifact files.",
      "type": [
        "string",
        "null"
      ]
    },
    "final_state_hash": {
      "description": "Semantic state hash at the selected interval's end.",
      "type": "string"
    },
    "ghostty_revision": {
      "description": "Exact Ghostty source revision.",
      "type": "string"
    },
    "members": {
      "description": "Whole-file integrity and classification for every payload member.",
      "items": {
        "$ref": "#/$defs/ArtifactMember"
      },
      "type": "array"
    },
    "semantic_state_count": {
      "description": "Number of distinct semantic states encountered during replay.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "description": "Source session identifier.",
      "format": "uuid",
      "type": "string"
    },
    "source_complete": {
      "description": "Whether completion proved the source event log immutable.",
      "type": "boolean"
    },
    "source_event_hash": {
      "description": "Source event-log terminal hash.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "Selected half-open source interval, absent for a full-session index."
    },
    "state_count": {
      "description": "Number of state records retained in the artifact files.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "state_selection": {
      "$ref": "#/$defs/StateSelection",
      "description": "Semantic states retained in the JSONL artifacts."
    },
    "version": {
      "description": "Artifact schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "source_complete",
    "state_selection",
    "ghostty_revision",
    "state_count",
    "semantic_state_count",
    "final_state_hash",
    "members"
  ],
  "title": "ReplayManifest",
  "type": "object"
}
