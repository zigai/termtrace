{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "DirtyState": {
      "description": "Global render dirtiness reported by Ghostty.",
      "oneOf": [
        {
          "const": "clean",
          "description": "No visual change.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "One or more rows changed.",
          "type": "string"
        },
        {
          "const": "full",
          "description": "Full redraw required.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "One ordered session event.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Bytes read from the child PTY.",
          "properties": {
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact bytes, including control sequences and invalid UTF-8."
            },
            "type": {
              "const": "output",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Durable intent to send bytes to the child PTY.",
          "properties": {
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact emitted bytes."
            },
            "descriptor": {
              "$ref": "#/$defs/InputDescriptor",
              "description": "Structured semantic source of the exact emitted bytes."
            },
            "input_kind": {
              "$ref": "#/$defs/InputKind",
              "description": "High-level input category."
            },
            "intent": {
              "description": "Optional symbolic intent such as `ctrl-c` or `paste`.",
              "type": [
                "string",
                "null"
              ]
            },
            "operation_id": {
              "description": "Identifier paired with the corresponding result.",
              "format": "uuid",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/InputSource",
              "description": "Input origin."
            },
            "type": {
              "const": "input_intent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "source",
            "input_kind",
            "descriptor",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Result of one input intent.",
          "properties": {
            "bytes_written": {
              "description": "Bytes written before success or failure.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "error_code": {
              "description": "Stable diagnostic code on failure.",
              "type": [
                "string",
                "null"
              ]
            },
            "operation_id": {
              "description": "Identifier from the corresponding intent.",
              "format": "uuid",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/OperationStatus",
              "description": "Whether the entire byte sequence was applied."
            },
            "type": {
              "const": "input_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "status",
            "bytes_written"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Durable intent to change terminal geometry.",
          "properties": {
            "cols": {
              "description": "Columns after the resize.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "operation_id": {
              "description": "Identifier paired with the corresponding result.",
              "format": "uuid",
              "type": "string"
            },
            "pixel_height": {
              "description": "Total pixel height reported to the child.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "pixel_width": {
              "description": "Total pixel width reported to the child.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "rows": {
              "description": "Rows after the resize.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "resize_intent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "cols",
            "rows",
            "pixel_width",
            "pixel_height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Result of one resize intent.",
          "properties": {
            "error_code": {
              "description": "Stable diagnostic code on failure.",
              "type": [
                "string",
                "null"
              ]
            },
            "operation_id": {
              "description": "Identifier from the corresponding intent.",
              "format": "uuid",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/OperationStatus",
              "description": "Whether the new geometry was applied."
            },
            "type": {
              "const": "resize_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Durable intent to signal the child process group.",
          "properties": {
            "name": {
              "description": "Stable display name such as `SIGINT`.",
              "type": "string"
            },
            "number": {
              "description": "Platform signal number.",
              "format": "int32",
              "type": "integer"
            },
            "operation_id": {
              "description": "Identifier paired with the corresponding result.",
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "signal_intent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "number",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Result of one signal intent.",
          "properties": {
            "error_code": {
              "description": "Stable diagnostic code on failure.",
              "type": [
                "string",
                "null"
              ]
            },
            "operation_id": {
              "description": "Identifier from the corresponding intent.",
              "format": "uuid",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/OperationStatus",
              "description": "Whether the signal syscall succeeded."
            },
            "type": {
              "const": "signal_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A named point in the session timeline.",
          "properties": {
            "label": {
              "description": "User-provided marker label.",
              "type": "string"
            },
            "operation_id": {
              "description": "Caller-owned operation identifier used for durable deduplication.",
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "marker",
              "type": "string"
            }
          },
          "required": [
            "type",
            "operation_id",
            "label"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A terminal capability query and corresponding response.",
          "properties": {
            "query": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Query bytes emitted by the child."
            },
            "responder": {
              "description": "Component that generated the response.",
              "type": "string"
            },
            "response": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Response bytes sent back to the child."
            },
            "type": {
              "const": "query_response",
              "type": "string"
            }
          },
          "required": [
            "type",
            "query",
            "response",
            "responder"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A process or host lifecycle transition.",
          "properties": {
            "lifecycle_kind": {
              "$ref": "#/$defs/LifecycleKind",
              "description": "Transition kind."
            },
            "pid": {
              "description": "Child process ID when available.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "lifecycle",
              "type": "string"
            }
          },
          "required": [
            "type",
            "lifecycle_kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Child process termination.",
          "properties": {
            "code": {
              "description": "Exit status when the process exited normally.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "signal": {
              "description": "Signal number when signal termination occurred.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "signal_name": {
              "description": "Platform signal description when available.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "exit",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A host failure retained in the canonical timeline.",
          "properties": {
            "code": {
              "description": "Stable diagnostic code.",
              "type": "string"
            },
            "message": {
              "description": "Redacted human-readable message.",
              "type": "string"
            },
            "type": {
              "const": "host_error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "InputDescriptor": {
      "description": "Structured semantic provenance for exact input bytes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Uninterpreted caller or host bytes.",
          "properties": {
            "kind": {
              "const": "raw",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "UTF-8 text intentionally entered as textual content.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One semantic key encoded against a live terminal-mode snapshot.",
          "properties": {
            "alt": {
              "description": "Alt modifier.",
              "type": "boolean"
            },
            "control": {
              "description": "Control modifier.",
              "type": "boolean"
            },
            "encoder": {
              "description": "Pinned encoder identity.",
              "type": "string"
            },
            "key": {
              "description": "Stable symbolic key spelling.",
              "type": "string"
            },
            "kind": {
              "const": "key",
              "type": "string"
            },
            "shift": {
              "description": "Shift modifier.",
              "type": "boolean"
            },
            "super_key": {
              "description": "Super modifier.",
              "type": "boolean"
            },
            "terminal_modes_hash": {
              "description": "BLAKE3 of canonical JSON for the terminal mode snapshot.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key",
            "shift",
            "control",
            "alt",
            "super_key",
            "encoder",
            "terminal_modes_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Paste content encoded against live bracketed-paste mode.",
          "properties": {
            "bracketed": {
              "description": "Whether the actor applied bracketed-paste wrappers.",
              "type": "boolean"
            },
            "kind": {
              "const": "paste",
              "type": "string"
            },
            "terminal_modes_hash": {
              "description": "BLAKE3 of canonical JSON for the terminal mode snapshot.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bracketed",
            "terminal_modes_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Focus transition encoded while DEC focus reporting was enabled.",
          "properties": {
            "encoder": {
              "description": "Pinned encoder identity.",
              "type": "string"
            },
            "focused": {
              "description": "Whether the terminal gained (`true`) or lost (`false`) focus.",
              "type": "boolean"
            },
            "kind": {
              "const": "focus",
              "type": "string"
            },
            "terminal_modes_hash": {
              "description": "BLAKE3 of canonical JSON for the terminal mode snapshot.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "focused",
            "encoder",
            "terminal_modes_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pointer operation encoded against live mouse modes and geometry.",
          "properties": {
            "button": {
              "description": "Button name for clicks, otherwise wheel direction.",
              "type": "string"
            },
            "cols": {
              "description": "Terminal columns at encoding time.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "column": {
              "description": "Zero-based viewport column.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "encoder": {
              "description": "Pinned encoder identity.",
              "type": "string"
            },
            "kind": {
              "const": "pointer",
              "type": "string"
            },
            "lines": {
              "description": "Signed requested wheel lines, or zero for clicks.",
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768,
              "type": "integer"
            },
            "operation": {
              "description": "`click` or `scroll`.",
              "type": "string"
            },
            "pixel_height": {
              "description": "Total terminal surface height in pixels.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "pixel_width": {
              "description": "Total terminal surface width in pixels.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "row": {
              "description": "Zero-based viewport row.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "rows": {
              "description": "Terminal rows at encoding time.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "terminal_modes_hash": {
              "description": "BLAKE3 of canonical JSON for the terminal mode snapshot.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "operation",
            "button",
            "lines",
            "column",
            "row",
            "cols",
            "rows",
            "pixel_width",
            "pixel_height",
            "encoder",
            "terminal_modes_hash"
          ],
          "type": "object"
        }
      ]
    },
    "InputKind": {
      "description": "User-facing interpretation of an input byte sequence.",
      "oneOf": [
        {
          "const": "raw",
          "description": "Uninterpreted bytes.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Typed textual content.",
          "type": "string"
        },
        {
          "const": "keys",
          "description": "One or more symbolic keyboard keys.",
          "type": "string"
        },
        {
          "const": "paste",
          "description": "Pasted content.",
          "type": "string"
        },
        {
          "const": "focus",
          "description": "Terminal-window focus transition.",
          "type": "string"
        },
        {
          "const": "pointer",
          "description": "Cell-addressed mouse or wheel operation.",
          "type": "string"
        }
      ]
    },
    "InputSource": {
      "description": "Origin of bytes sent to the child process.",
      "oneOf": [
        {
          "const": "human",
          "description": "Input received from the attached native terminal.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Input requested through the agent control protocol.",
          "type": "string"
        },
        {
          "const": "host",
          "description": "Automatic terminal-host response or internal control input.",
          "type": "string"
        }
      ]
    },
    "LifecycleKind": {
      "description": "Why a process lifecycle transition occurred.",
      "oneOf": [
        {
          "const": "spawned",
          "description": "The PTY and child process were created.",
          "type": "string"
        },
        {
          "const": "output_closed",
          "description": "The child output stream reached end-of-file.",
          "type": "string"
        },
        {
          "const": "stopping",
          "description": "The session host began orderly shutdown.",
          "type": "string"
        }
      ]
    },
    "OperationStatus": {
      "description": "Result of a state-changing operation.",
      "oneOf": [
        {
          "const": "applied",
          "description": "The complete operation was applied once.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The operation failed without a complete application.",
          "type": "string"
        }
      ]
    },
    "TimelineItem": {
      "description": "Concise canonical or semantic item in a diagnostic timeline.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A distinct Ghostty semantic state transition.",
          "properties": {
            "changed_cells": {
              "description": "Number of complete semantic cell values changed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "changed_rows": {
              "description": "Rows whose semantic cells changed.",
              "items": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "cursor_changed": {
              "description": "Whether cursor state changed.",
              "type": "boolean"
            },
            "event_byte_offset": {
              "description": "Byte offset within the responsible output event.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "ghostty_dirty": {
              "$ref": "#/$defs/DirtyState",
              "description": "Ghostty's dirty classification."
            },
            "kind": {
              "const": "semantic_state",
              "type": "string"
            },
            "metadata_changed": {
              "description": "Whether terminal metadata changed.",
              "type": "boolean"
            },
            "modes_changed": {
              "description": "Whether terminal modes changed.",
              "type": "boolean"
            },
            "presented": {
              "description": "Whether the state was eligible for presentation.",
              "type": "boolean"
            },
            "state_hash": {
              "description": "Complete normalized semantic state hash.",
              "type": "string"
            },
            "state_id": {
              "description": "Dense semantic state identifier.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "state_id",
            "state_hash",
            "presented",
            "ghostty_dirty",
            "changed_rows",
            "changed_cells",
            "cursor_changed",
            "modes_changed",
            "metadata_changed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A non-output canonical event retained verbatim.",
          "properties": {
            "event": {
              "$ref": "#/$defs/Event",
              "description": "Exact typed canonical event."
            },
            "kind": {
              "const": "canonical_event",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "event"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One lossless explanatory VT frame.",
          "properties": {
            "kind": {
              "const": "vt_token",
              "type": "string"
            },
            "token": {
              "$ref": "#/$defs/VtToken",
              "description": "Exact token and canonical source segments."
            }
          },
          "required": [
            "kind",
            "token"
          ],
          "type": "object"
        }
      ]
    },
    "VtSourceSegment": {
      "additionalProperties": false,
      "description": "Half-open byte range within one canonical output event.",
      "properties": {
        "end_byte_offset": {
          "description": "Exclusive byte offset within the event payload.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "event_seq": {
          "description": "Canonical output event sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "monotonic_ns": {
          "description": "Session-monotonic event timestamp.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_byte_offset": {
          "description": "Inclusive byte offset within the event payload.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "event_seq",
        "start_byte_offset",
        "end_byte_offset",
        "monotonic_ns"
      ],
      "type": "object"
    },
    "VtToken": {
      "additionalProperties": false,
      "description": "One lossless VT frame with exact canonical source ranges.",
      "properties": {
        "description": {
          "description": "Stable neutral description for common controls.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/VtTokenKind",
          "description": "Framed sequence family."
        },
        "raw": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Exact bytes, including introducer and terminator."
        },
        "source": {
          "description": "Ordered exact source segments; concatenating them reproduces `raw`.",
          "items": {
            "$ref": "#/$defs/VtSourceSegment"
          },
          "type": "array"
        },
        "timing_resolution": {
          "description": "Timing resolution; current recordings timestamp complete PTY reads.",
          "type": "string"
        },
        "token_id": {
          "description": "Dense token identifier.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "token_id",
        "kind",
        "raw",
        "source",
        "description",
        "timing_resolution"
      ],
      "type": "object"
    },
    "VtTokenKind": {
      "description": "Stable VT token family. This is framing, not terminal interpretation.",
      "oneOf": [
        {
          "const": "printable",
          "description": "Printable bytes, including valid UTF-8 continuation bytes.",
          "type": "string"
        },
        {
          "const": "c0",
          "description": "One C0 control byte.",
          "type": "string"
        },
        {
          "const": "c1",
          "description": "One 8-bit C1 control byte.",
          "type": "string"
        },
        {
          "const": "esc",
          "description": "ESC sequence.",
          "type": "string"
        },
        {
          "const": "csi",
          "description": "Control Sequence Introducer sequence.",
          "type": "string"
        },
        {
          "const": "osc",
          "description": "Operating System Command string.",
          "type": "string"
        },
        {
          "const": "dcs",
          "description": "Device Control String.",
          "type": "string"
        },
        {
          "const": "apc",
          "description": "Application Program Command string.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Syntactically malformed or unrecognized sequence.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Sequence still open at end of canonical output.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/timeline-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One ordered, source-bound timeline item.",
  "properties": {
    "event_seq": {
      "description": "Responsible canonical event, absent for the initial semantic state.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "item": {
      "$ref": "#/$defs/TimelineItem",
      "description": "Timeline item payload."
    },
    "monotonic_ns": {
      "description": "Canonical session offset.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "monotonic_ns",
    "item"
  ],
  "title": "TimelineEntry",
  "type": "object"
}
