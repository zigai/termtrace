{
  "$defs": {
    "ActorBoundaries": {
      "additionalProperties": false,
      "description": "Durable and latest actor-processed positions returned by live operations.",
      "properties": {
        "durable": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary whose file synchronization completed successfully."
        },
        "observed": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary processed by the session actor, possibly volatile."
        }
      },
      "required": [
        "durable",
        "observed"
      ],
      "type": "object"
    },
    "CanonicalBoundary": {
      "additionalProperties": false,
      "description": "Actor-consistent position in the canonical event stream.",
      "properties": {
        "event_hash": {
          "description": "Hash of the preceding event, or the event header at sequence zero.",
          "type": "string"
        },
        "next_event_seq": {
          "description": "Sequence number that will be assigned to the next event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "PTY output bytes included through this boundary.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "next_event_seq",
        "event_hash",
        "output_bytes"
      ],
      "type": "object"
    },
    "CaptureQuality": {
      "description": "How settled the observed state is.",
      "oneOf": [
        {
          "const": "live",
          "description": "Immediate state from a responsive live actor.",
          "type": "string"
        },
        {
          "const": "stable",
          "description": "Live state proven unchanged for a requested interval.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "State from validated completed evidence.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Explicitly incomplete validated prefix.",
          "type": "string"
        }
      ]
    },
    "CellStyle": {
      "description": "Complete style attached to one terminal cell.",
      "properties": {
        "background": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Background color source."
        },
        "blink": {
          "description": "Blink attribute.",
          "type": "boolean"
        },
        "bold": {
          "description": "Bold attribute.",
          "type": "boolean"
        },
        "faint": {
          "description": "Faint attribute.",
          "type": "boolean"
        },
        "foreground": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Foreground color source."
        },
        "inverse": {
          "description": "Inverse-video attribute.",
          "type": "boolean"
        },
        "invisible": {
          "description": "Invisible attribute.",
          "type": "boolean"
        },
        "italic": {
          "description": "Italic attribute.",
          "type": "boolean"
        },
        "overline": {
          "description": "Overline attribute.",
          "type": "boolean"
        },
        "strikethrough": {
          "description": "Strikethrough attribute.",
          "type": "boolean"
        },
        "underline": {
          "description": "Upstream SGR underline value (`0` through `5`).",
          "format": "int32",
          "type": "integer"
        },
        "underline_color": {
          "$ref": "#/$defs/ColorSpec",
          "description": "Underline color source."
        }
      },
      "required": [
        "foreground",
        "background",
        "underline_color",
        "bold",
        "italic",
        "faint",
        "blink",
        "inverse",
        "invisible",
        "strikethrough",
        "overline",
        "underline"
      ],
      "type": "object"
    },
    "ColorSpec": {
      "description": "Cell color source before default-color fallback.",
      "oneOf": [
        {
          "description": "No explicit color.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Index into the active 256-color palette.",
          "properties": {
            "kind": {
              "const": "palette",
              "type": "string"
            },
            "value": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Explicit true color.",
          "properties": {
            "kind": {
              "const": "rgb",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ColorState": {
      "description": "Active terminal colors.",
      "properties": {
        "background": {
          "$ref": "#/$defs/Rgb",
          "description": "Default/current background."
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit cursor color."
        },
        "foreground": {
          "$ref": "#/$defs/Rgb",
          "description": "Default/current foreground."
        },
        "palette": {
          "description": "Active 256-color palette.",
          "items": {
            "$ref": "#/$defs/Rgb"
          },
          "type": "array"
        }
      },
      "required": [
        "background",
        "foreground",
        "palette"
      ],
      "type": "object"
    },
    "CursorState": {
      "description": "Cursor state at one semantic boundary.",
      "properties": {
        "blinking": {
          "description": "Blink mode.",
          "type": "boolean"
        },
        "column": {
          "description": "Viewport column when available.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "in_viewport": {
          "description": "Whether the cursor lies in the viewport.",
          "type": "boolean"
        },
        "row": {
          "description": "Viewport row when available.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/CursorStyle",
          "description": "Visual shape."
        },
        "visible": {
          "description": "Visibility mode.",
          "type": "boolean"
        },
        "wide_tail": {
          "description": "Whether the cursor is on a wide-character tail.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "visible",
        "blinking",
        "in_viewport",
        "style"
      ],
      "type": "object"
    },
    "CursorStyle": {
      "description": "Cursor visual style.",
      "oneOf": [
        {
          "const": "bar",
          "description": "Vertical bar.",
          "type": "string"
        },
        {
          "const": "block",
          "description": "Filled block.",
          "type": "string"
        },
        {
          "const": "underline",
          "description": "Underline.",
          "type": "string"
        },
        {
          "const": "hollow_block",
          "description": "Hollow block.",
          "type": "string"
        }
      ]
    },
    "ModeState": {
      "description": "Terminal modes relevant to presentation and input.",
      "properties": {
        "alternate_screen": {
          "description": "Any alternate-screen mode.",
          "type": "boolean"
        },
        "bracketed_paste": {
          "description": "DEC bracketed-paste mode 2004.",
          "type": "boolean"
        },
        "synchronized_output": {
          "description": "DEC synchronized-output mode 2026.",
          "type": "boolean"
        },
        "values": {
          "description": "Complete stable inventory of known ANSI and DEC modes.",
          "items": {
            "$ref": "#/$defs/TerminalMode"
          },
          "type": "array"
        },
        "wraparound": {
          "description": "DEC auto-wrap mode 7.",
          "type": "boolean"
        }
      },
      "required": [
        "synchronized_output",
        "alternate_screen",
        "wraparound",
        "bracketed_paste",
        "values"
      ],
      "type": "object"
    },
    "ObservationIntegrity": {
      "description": "Integrity relationship between an observation and canonical evidence.",
      "oneOf": [
        {
          "const": "canonical_chained",
          "description": "State derives from a validated canonical hash chain or live actor boundary.",
          "type": "string"
        },
        {
          "const": "unchained",
          "description": "State derives from an unchained byte stream.",
          "type": "string"
        }
      ]
    },
    "ObservationResolution": {
      "description": "Service path used to resolve an observation without changing its meaning.",
      "oneOf": [
        {
          "const": "actor_snapshot",
          "description": "Actor-consistent live snapshot fast path.",
          "type": "string"
        },
        {
          "const": "canonical_replay",
          "description": "Independently validated canonical event replay.",
          "type": "string"
        },
        {
          "const": "validated_checkpoint",
          "description": "Content-addressed full-state checkpoint validated against exact source bytes.",
          "type": "string"
        },
        {
          "const": "ansi_interpretation",
          "description": "Pinned semantic interpretation of an unchained ANSI stream.",
          "type": "string"
        }
      ]
    },
    "ObservationSourceKind": {
      "description": "Source category for one observation.",
      "oneOf": [
        {
          "const": "live_session",
          "description": "Responsive canonical recording actor.",
          "type": "string"
        },
        {
          "const": "completed_session",
          "description": "Validated completed canonical recording.",
          "type": "string"
        },
        {
          "const": "interrupted_session",
          "description": "Explicitly validated but incomplete canonical event prefix.",
          "type": "string"
        },
        {
          "const": "ansi_stream",
          "description": "Unchained ANSI/VT byte stream.",
          "type": "string"
        },
        {
          "const": "imported_ansi",
          "description": "Completed canonical evidence imported from an ANSI/VT byte stream.",
          "type": "string"
        },
        {
          "const": "one_off_command",
          "description": "Canonical recording allocated for a one-off command.",
          "type": "string"
        }
      ]
    },
    "Rgb": {
      "description": "RGB color independent of libghostty's unstable ABI.",
      "properties": {
        "b": {
          "description": "Blue channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "g": {
          "description": "Green channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "r": {
          "description": "Red channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "r",
        "g",
        "b"
      ],
      "type": "object"
    },
    "ScreenAppearance": {
      "additionalProperties": false,
      "description": "Complete appearance shared by an exact cell or a lossless span.",
      "properties": {
        "resolved_background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved explicit background before default fallback."
        },
        "resolved_foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgb"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved explicit foreground before default fallback."
        },
        "selected": {
          "description": "Selection membership.",
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/CellStyle",
          "description": "Authoritative source style and color selectors."
        }
      },
      "required": [
        "style",
        "selected"
      ],
      "type": "object"
    },
    "ScreenCell": {
      "additionalProperties": false,
      "description": "Exact projected terminal cell.",
      "properties": {
        "appearance": {
          "$ref": "#/$defs/ScreenAppearance",
          "description": "Complete semantic appearance."
        },
        "column": {
          "description": "Absolute viewport column.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "grapheme": {
          "description": "Complete grapheme cluster, empty for a blank/spacer.",
          "type": "string"
        },
        "row": {
          "description": "Absolute viewport row.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "wide_kind": {
          "$ref": "#/$defs/WideKind",
          "description": "Native Ghostty width role."
        }
      },
      "required": [
        "row",
        "column",
        "grapheme",
        "wide_kind",
        "appearance"
      ],
      "type": "object"
    },
    "ScreenCellRow": {
      "additionalProperties": false,
      "description": "Cell-detail row.",
      "properties": {
        "cells": {
          "description": "Exact ordered cells.",
          "items": {
            "$ref": "#/$defs/ScreenCell"
          },
          "type": "array"
        },
        "row": {
          "description": "Absolute row.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "soft_wrapped": {
          "description": "Whether this row ends in a native soft wrap.",
          "type": "boolean"
        },
        "text": {
          "description": "Deterministic convenience text.",
          "type": "string"
        },
        "wrap_continuation": {
          "description": "Whether this row continues a native soft wrap.",
          "type": "boolean"
        }
      },
      "required": [
        "row",
        "soft_wrapped",
        "wrap_continuation",
        "text",
        "cells"
      ],
      "type": "object"
    },
    "ScreenFrame": {
      "additionalProperties": false,
      "description": "Versioned, bounded projection of one exact semantic state.",
      "properties": {
        "capture_quality": {
          "$ref": "#/$defs/CaptureQuality",
          "description": "Settlement/provenance label."
        },
        "colors": {
          "$ref": "#/$defs/ColorState",
          "description": "Current/default colors and complete palette."
        },
        "cursor": {
          "$ref": "#/$defs/CursorState",
          "description": "Complete cursor state."
        },
        "data": {
          "$ref": "#/$defs/ScreenFrameData",
          "description": "Structurally matched detail payload."
        },
        "frame_hash": {
          "description": "Projection identity in the `termtrace-screen-frame-v1` hash domain.",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/ScreenGeometry",
          "description": "Full viewport geometry."
        },
        "modes": {
          "$ref": "#/$defs/ModeState",
          "description": "Complete relevant terminal modes."
        },
        "presented": {
          "description": "Whether this state was presentation eligible.",
          "type": "boolean"
        },
        "requested_region": {
          "$ref": "#/$defs/ScreenRegion",
          "description": "Validated requested region."
        },
        "returned_region": {
          "$ref": "#/$defs/ScreenRegion",
          "description": "Actually returned region; equal to requested in version 1."
        },
        "source": {
          "$ref": "#/$defs/ScreenFrameSource",
          "description": "Exact source occurrence."
        },
        "state_hash": {
          "description": "Complete semantic v5 state identity.",
          "type": "string"
        },
        "version": {
          "description": "Projection format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "state_hash",
        "presented",
        "capture_quality",
        "source",
        "geometry",
        "requested_region",
        "returned_region",
        "cursor",
        "modes",
        "colors",
        "data",
        "frame_hash"
      ],
      "type": "object"
    },
    "ScreenFrameData": {
      "description": "Structurally discriminated rich row payload.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Observation metadata only; no cell or text payload.",
          "properties": {
            "detail": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "detail"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Convenience text and authoritative wrap facts.",
          "properties": {
            "detail": {
              "const": "text",
              "type": "string"
            },
            "rows": {
              "description": "Ordered projected rows.",
              "items": {
                "$ref": "#/$defs/ScreenTextRow"
              },
              "type": "array"
            }
          },
          "required": [
            "detail",
            "rows"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lossless appearance spans.",
          "properties": {
            "detail": {
              "const": "spans",
              "type": "string"
            },
            "rows": {
              "description": "Ordered projected rows.",
              "items": {
                "$ref": "#/$defs/ScreenSpanRow"
              },
              "type": "array"
            }
          },
          "required": [
            "detail",
            "rows"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact cells.",
          "properties": {
            "detail": {
              "const": "cells",
              "type": "string"
            },
            "rows": {
              "description": "Ordered projected rows.",
              "items": {
                "$ref": "#/$defs/ScreenCellRow"
              },
              "type": "array"
            }
          },
          "required": [
            "detail",
            "rows"
          ],
          "type": "object"
        }
      ]
    },
    "ScreenFrameSource": {
      "description": "Exact provenance of the projected semantic state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "State selected while the live actor still owned exclusivity.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and actor-observed canonical boundaries."
            },
            "observed_monotonic_ns": {
              "description": "Actor observation time in session-monotonic nanoseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "description": "Canonical session identity.",
              "format": "uuid",
              "type": "string"
            },
            "source": {
              "const": "actor",
              "type": "string"
            }
          },
          "required": [
            "source",
            "session_id",
            "boundaries",
            "observed_monotonic_ns"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "State selected through a completed or explicit semantic resolution.",
          "properties": {
            "boundary": {
              "$ref": "#/$defs/CanonicalBoundary",
              "description": "Exact validated source boundary."
            },
            "event_seq": {
              "description": "Responsible canonical event sequence when known.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "integrity": {
              "$ref": "#/$defs/ObservationIntegrity",
              "description": "Integrity relationship to canonical evidence."
            },
            "monotonic_ns": {
              "description": "Session-monotonic timestamp when known.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "resolution": {
              "$ref": "#/$defs/ObservationResolution",
              "description": "Resolution path used to select the state."
            },
            "session_id": {
              "description": "Canonical session identity when available.",
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "const": "resolved",
              "type": "string"
            },
            "source_completed": {
              "description": "Whether canonical evidence completed durably.",
              "type": "boolean"
            },
            "source_kind": {
              "$ref": "#/$defs/ObservationSourceKind",
              "description": "Source category."
            },
            "state_id": {
              "description": "Dense semantic state identity when assigned.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "state_point": {
              "$ref": "#/$defs/StatePoint",
              "description": "Requested state selector."
            }
          },
          "required": [
            "source",
            "source_kind",
            "source_completed",
            "state_point",
            "boundary",
            "integrity",
            "resolution"
          ],
          "type": "object"
        }
      ]
    },
    "ScreenGeometry": {
      "additionalProperties": false,
      "description": "Complete terminal geometry, independent of the returned region.",
      "properties": {
        "cols": {
          "description": "Viewport columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Viewport rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "ScreenMode": {
      "description": "Stable terminal-mode selectors available to screen predicates.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Any alternate-screen mode.",
          "properties": {
            "mode": {
              "const": "alternate_screen",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC bracketed-paste mode 2004.",
          "properties": {
            "mode": {
              "const": "bracketed_paste",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC auto-wrap mode 7.",
          "properties": {
            "mode": {
              "const": "wraparound",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC synchronized-output mode 2026.",
          "properties": {
            "mode": {
              "const": "synchronized_output",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numeric ANSI mode.",
          "properties": {
            "mode": {
              "const": "ansi",
              "type": "string"
            },
            "number": {
              "description": "Mode number.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "number"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numeric DEC-private mode.",
          "properties": {
            "mode": {
              "const": "dec",
              "type": "string"
            },
            "number": {
              "description": "Mode number.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "number"
          ],
          "type": "object"
        }
      ]
    },
    "ScreenPredicate": {
      "description": "Exact predicate evaluated against the latest presented viewport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Viewport text contains an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "contains",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
