{
  "$defs": {
    "ActorBoundaries": {
      "additionalProperties": false,
      "description": "Durable and latest actor-processed positions returned by live operations.",
      "properties": {
        "durable": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary whose file synchronization completed successfully."
        },
        "observed": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary processed by the session actor, possibly volatile."
        }
      },
      "required": [
        "durable",
        "observed"
      ],
      "type": "object"
    },
    "CanonicalBoundary": {
      "additionalProperties": false,
      "description": "Actor-consistent position in the canonical event stream.",
      "properties": {
        "event_hash": {
          "description": "Hash of the preceding event, or the event header at sequence zero.",
          "type": "string"
        },
        "next_event_seq": {
          "description": "Sequence number that will be assigned to the next event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "PTY output bytes included through this boundary.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "next_event_seq",
        "event_hash",
        "output_bytes"
      ],
      "type": "object"
    },
    "CursorStyle": {
      "description": "Cursor visual style.",
      "oneOf": [
        {
          "const": "bar",
          "description": "Vertical bar.",
          "type": "string"
        },
        {
          "const": "block",
          "description": "Filled block.",
          "type": "string"
        },
        {
          "const": "underline",
          "description": "Underline.",
          "type": "string"
        },
        {
          "const": "hollow_block",
          "description": "Hollow block.",
          "type": "string"
        }
      ]
    },
    "ScreenMode": {
      "description": "Stable terminal-mode selectors available to screen predicates.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Any alternate-screen mode.",
          "properties": {
            "mode": {
              "const": "alternate_screen",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC bracketed-paste mode 2004.",
          "properties": {
            "mode": {
              "const": "bracketed_paste",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC auto-wrap mode 7.",
          "properties": {
            "mode": {
              "const": "wraparound",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "DEC synchronized-output mode 2026.",
          "properties": {
            "mode": {
              "const": "synchronized_output",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numeric ANSI mode.",
          "properties": {
            "mode": {
              "const": "ansi",
              "type": "string"
            },
            "number": {
              "description": "Mode number.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "number"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numeric DEC-private mode.",
          "properties": {
            "mode": {
              "const": "dec",
              "type": "string"
            },
            "number": {
              "description": "Mode number.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "number"
          ],
          "type": "object"
        }
      ]
    },
    "ScreenPredicate": {
      "description": "Exact predicate evaluated against the latest presented viewport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Viewport text contains an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "contains",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Viewport text excludes an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "absent",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Viewport text matches a bounded linear-time regular expression.",
          "properties": {
            "pattern": {
              "description": "Rust-regex pattern, limited by the control service.",
              "type": "string"
            },
            "predicate": {
              "const": "matches_regex",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "pattern"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Viewport text does not match a bounded linear-time regular expression.",
          "properties": {
            "pattern": {
              "description": "Rust-regex pattern, limited by the control service.",
              "type": "string"
            },
            "predicate": {
              "const": "excludes_regex",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "pattern"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One zero-based row contains exact UTF-8 text.",
          "properties": {
            "predicate": {
              "const": "row_contains",
              "type": "string"
            },
            "row": {
              "description": "Zero-based viewport row.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "row",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One zero-based row excludes exact UTF-8 text.",
          "properties": {
            "predicate": {
              "const": "row_absent",
              "type": "string"
            },
            "row": {
              "description": "Zero-based viewport row.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "row",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A half-open cell region contains exact UTF-8 text.",
          "properties": {
            "predicate": {
              "const": "region_contains",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/ScreenRegion",
              "description": "Region bounds in viewport cells."
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "region",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A half-open cell region excludes exact UTF-8 text.",
          "properties": {
            "predicate": {
              "const": "region_absent",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/ScreenRegion",
              "description": "Region bounds in viewport cells."
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "region",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cursor properties all equal the supplied values.",
          "properties": {
            "column": {
              "description": "Optional zero-based viewport column.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "predicate": {
              "const": "cursor",
              "type": "string"
            },
            "row": {
              "description": "Optional zero-based viewport row.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "shape": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CursorStyle"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional cursor shape requirement."
            },
            "visible": {
              "description": "Optional cursor visibility requirement.",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "predicate"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One stable terminal mode equals the requested value.",
          "properties": {
            "enabled": {
              "description": "Required set/reset value.",
              "type": "boolean"
            },
            "mode": {
              "$ref": "#/$defs/ScreenMode",
              "description": "Stable mode selector."
            },
            "predicate": {
              "const": "mode",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "mode",
            "enabled"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Presented state hash equals or differs from a supplied BLAKE3 hash.",
          "properties": {
            "comparison": {
              "$ref": "#/$defs/StateHashComparison",
              "description": "Equality relationship to require."
            },
            "hash": {
              "description": "Lowercase BLAKE3 state hash.",
              "type": "string"
            },
            "predicate": {
              "const": "state_hash",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "hash",
            "comparison"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Every nested predicate must match.",
          "properties": {
            "predicate": {
              "const": "all",
              "type": "string"
            },
            "predicates": {
              "description": "Bounded non-empty predicate list.",
              "items": {
                "$ref": "#/$defs/ScreenPredicate"
              },
              "type": "array"
            }
          },
          "required": [
            "predicate",
            "predicates"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "At least one nested predicate must match.",
          "properties": {
            "predicate": {
              "const": "any",
              "type": "string"
            },
            "predicates": {
              "description": "Bounded non-empty predicate list.",
              "items": {
                "$ref": "#/$defs/ScreenPredicate"
              },
              "type": "array"
            }
          },
          "required": [
            "predicate",
            "predicates"
          ],
          "type": "object"
        }
      ]
    },
    "ScreenRegion": {
      "additionalProperties": false,
      "description": "Half-open viewport region used by structural screen predicates.",
      "properties": {
        "bottom": {
          "description": "Exclusive bottom row.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "left": {
          "description": "Inclusive zero-based left column.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "right": {
          "description": "Exclusive right column.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "description": "Inclusive zero-based top row.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "type": "object"
    },
    "StateHashComparison": {
      "description": "Required relationship between the presented state and a supplied hash.",
      "oneOf": [
        {
          "const": "unchanged",
          "description": "Current state must equal the supplied hash.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Current state must differ from the supplied hash.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/screen-wait-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Successful presented-screen wait evidence.",
  "properties": {
    "boundaries": {
      "$ref": "#/$defs/ActorBoundaries",
      "description": "Actor-consistent canonical source boundaries."
    },
    "child_completed": {
      "description": "Whether completion was present when the result was returned.",
      "type": "boolean"
    },
    "cols": {
      "description": "Terminal columns.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "completion_quality": {
      "description": "`stable` or `matched_unsettled`.",
      "type": "string"
    },
    "first_match_monotonic_ns": {
      "description": "First session-monotonic timestamp at which this unchanged state matched.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "predicate": {
      "$ref": "#/$defs/ScreenPredicate",
      "description": "Predicate that matched."
    },
    "presented": {
      "description": "Whether the observed state was presentation eligible.",
      "type": "boolean"
    },
    "rows": {
      "description": "Terminal rows.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "scope": {
      "description": "Observation scope, fixed to `screen`.",
      "type": "string"
    },
    "stable_for_ns": {
      "description": "Requested stability duration.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "stable_through_monotonic_ns": {
      "description": "Last session-monotonic timestamp through which the state remained stable.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "state_hash": {
      "description": "Full presentation-eligible semantic state hash.",
      "type": "string"
    }
  },
  "required": [
    "predicate",
    "scope",
    "state_hash",
    "presented",
    "first_match_monotonic_ns",
    "stable_through_monotonic_ns",
    "stable_for_ns",
    "boundaries",
    "child_completed",
    "cols",
    "rows",
    "completion_quality"
  ],
  "title": "ScreenWaitOutcome",
  "type": "object"
}
