{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "CaptureTarget": {
      "description": "Pixel viewport intended for native visual capture.",
      "properties": {
        "height": {
          "description": "Viewport height in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "padding": {
          "$ref": "#/$defs/WindowPadding",
          "description": "Balanced Ghostty window padding that fits a grid smaller than Ghostty's minimum window."
        },
        "width": {
          "description": "Viewport width in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "ChildEnvironmentPolicy": {
      "additionalProperties": false,
      "description": "Value-free environment declaration retained in canonical evidence.",
      "properties": {
        "base": {
          "$ref": "#/$defs/EnvironmentBase",
          "description": "Base environment policy."
        },
        "color": {
          "$ref": "#/$defs/ColorPolicy",
          "description": "Deterministic color-variable behavior."
        },
        "copied_names": {
          "description": "Names copied from the recorder environment.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "effective_digest": {
          "description": "BLAKE3 commitment to the exact ordered name/value byte pairs passed to the child.",
          "type": "string"
        },
        "explicit_names": {
          "description": "Names whose values were supplied explicitly.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "unset_names": {
          "description": "Names explicitly removed before host policy was applied.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "base",
        "explicit_names",
        "copied_names",
        "unset_names",
        "color",
        "effective_digest"
      ],
      "type": "object"
    },
    "ColorPolicy": {
      "description": "Deterministic common color-variable policy applied after caller overrides.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Preserve inherited color variables and add none to a clear environment.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Request colored output through common de-facto variables.",
          "type": "string"
        },
        {
          "const": "never",
          "description": "Request plain output through common de-facto variables.",
          "type": "string"
        }
      ]
    },
    "ContentIdentityStatus": {
      "description": "Whether content identity was retained for a resolved file.",
      "oneOf": [
        {
          "const": "not_requested",
          "description": "The policy did not request file content hashing.",
          "type": "string"
        },
        {
          "const": "captured",
          "description": "BLAKE3 was computed from the complete file.",
          "type": "string"
        },
        {
          "const": "unresolved",
          "description": "The path could not be resolved to an executable or regular file.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "A resolved file could not be read completely.",
          "type": "string"
        }
      ]
    },
    "DurabilityMode": {
      "description": "Output persistence behavior selected for one canonical recording.",
      "oneOf": [
        {
          "const": "strict",
          "description": "Synchronize every PTY output event before processing continues.",
          "type": "string"
        },
        {
          "const": "bounded",
          "description": "Synchronize after a configured output-byte or elapsed-time threshold.",
          "type": "string"
        },
        {
          "const": "throughput",
          "description": "Buffer PTY output until a mutation, lifecycle, or completion boundary.",
          "type": "string"
        }
      ]
    },
    "DurabilityPolicy": {
      "additionalProperties": false,
      "description": "Chain-bound configuration for canonical output persistence.",
      "properties": {
        "maximum_interval_ms": {
          "description": "Maximum uncommitted interval for bounded mode.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maximum_uncommitted_bytes": {
          "description": "Maximum uncommitted PTY bytes for bounded mode.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/DurabilityMode",
          "description": "Selected persistence behavior."
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "EnvironmentBase": {
      "description": "Source environment used before explicit child overrides are applied.",
      "oneOf": [
        {
          "const": "inherit",
          "description": "Snapshot and inherit the recorder process environment.",
          "type": "string"
        },
        {
          "const": "clear",
          "description": "Begin with an empty environment.",
          "type": "string"
        }
      ]
    },
    "EnvironmentProvenance": {
      "additionalProperties": false,
      "description": "Captured or inventoried environment provenance.",
      "properties": {
        "capture": {
          "$ref": "#/$defs/ProvenanceCapture",
          "description": "Representation selected by the policy."
        },
        "present": {
          "description": "Whether the variable existed in the effective child environment.",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/ProvenanceSensitivity",
          "description": "Sensitivity classification used by exporters and reviewers."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Base64Bytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact bytes when capture is `value`."
        },
        "value_hash": {
          "description": "BLAKE3 of the exact value bytes for `value` or `hash` capture.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "capture",
        "present",
        "sensitivity"
      ],
      "type": "object"
    },
    "ExecutionProvenance": {
      "additionalProperties": false,
      "description": "Policy plus its immutable environment inventory.",
      "properties": {
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentProvenance"
          },
          "description": "Selected effective child-environment facts, ordered by name.",
          "type": "object"
        },
        "executable": {
          "$ref": "#/$defs/FileProvenance",
          "description": "Resolved executable identity."
        },
        "invoked_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileProvenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Interpreter-invoked script when it can be identified without guessing."
        },
        "policy": {
          "$ref": "#/$defs/ProvenancePolicy",
          "description": "Policy that selected the inventory."
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeProvenance",
          "description": "Recorder, kernel, and local identity facts."
        }
      },
      "required": [
        "policy",
        "environment",
        "executable",
        "runtime"
      ],
      "type": "object"
    },
    "FileProvenance": {
      "additionalProperties": false,
      "description": "Exact requested path plus resolved content identity.",
      "properties": {
        "content_hash": {
          "description": "Complete-file BLAKE3 under a policy that requests content identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_identity": {
          "$ref": "#/$defs/ContentIdentityStatus",
          "description": "Explicit content identity outcome."
        },
        "requested": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Bytes supplied by the caller or discovered as an interpreter argument."
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Base64Bytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical resolved path bytes when resolution succeeded."
        }
      },
      "required": [
        "requested",
        "content_identity"
      ],
      "type": "object"
    },
    "GeometryProvenance": {
      "additionalProperties": false,
      "description": "Provenance for automatic terminal geometry selection.",
      "properties": {
        "capture_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTarget"
            },
            {
              "type": "null"
            }
          ],
          "description": "Intended native-capture viewport, when selected during recording."
        },
        "source": {
          "$ref": "#/$defs/GeometrySource",
          "description": "How the initial geometry was selected."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "GeometrySource": {
      "description": "Origin of the initial terminal geometry.",
      "oneOf": [
        {
          "const": "manual",
          "description": "Explicit columns, rows, and cell dimensions.",
          "type": "string"
        },
        {
          "const": "inherited",
          "description": "Dimensions inherited from the controlling terminal.",
          "type": "string"
        },
        {
          "const": "ghostty_fit",
          "description": "Dimensions measured from Ghostty at a target viewport size.",
          "type": "string"
        }
      ]
    },
    "GhosttyVisualOverrides": {
      "additionalProperties": false,
      "description": "Focused Termtrace overrides applied to a Ghostty visual profile.",
      "properties": {
        "background": {
          "description": "Default background color in Ghostty syntax.",
          "type": [
            "string",
            "null"
          ]
        },
        "font_family": {
          "description": "Regular terminal font family.",
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "description": "Font size in points, represented exactly as a Ghostty config value.",
          "type": [
            "string",
            "null"
          ]
        },
        "foreground": {
          "description": "Default foreground color in Ghostty syntax.",
          "type": [
            "string",
            "null"
          ]
        },
        "padding_x": {
          "description": "Symmetric horizontal window padding in points.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "padding_y": {
          "description": "Symmetric vertical window padding in points.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GhosttyVisualProvenance": {
      "additionalProperties": false,
      "description": "Persisted provenance for a canonical per-recording Ghostty profile.",
      "properties": {
        "effective_config_hash": {
          "description": "BLAKE3 of the exact effective configuration bytes freshly reported by Ghostty.",
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/GhosttyVisualOverrides",
          "description": "Focused overrides applied after resolving the source configuration."
        },
        "replay_profile": {
          "description": "Relative canonical replay-profile artifact.",
          "type": "string"
        },
        "replay_profile_hash": {
          "description": "BLAKE3 of the exact replay-profile input bytes.",
          "type": "string"
        },
        "source_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/Base64Bytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original custom configuration path bytes, when supplied."
        }
      },
      "required": [
        "overrides",
        "replay_profile",
        "replay_profile_hash",
        "effective_config_hash"
      ],
      "type": "object"
    },
    "ImportProvenance": {
      "additionalProperties": false,
      "description": "Chain-bound provenance for bytes imported from a noncanonical ANSI stream.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the exact imported bytes.",
          "type": "string"
        },
        "byte_count": {
          "description": "Exact imported byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Caller-facing path bytes or `-` for standard input."
        },
        "source_kind": {
          "description": "Stable source class, currently `ansi_stream`.",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "byte_count",
        "blake3",
        "source"
      ],
      "type": "object"
    },
    "KernelProvenance": {
      "additionalProperties": false,
      "description": "Runtime kernel identity returned by the host.",
      "properties": {
        "machine": {
          "description": "Runtime machine architecture.",
          "type": "string"
        },
        "release": {
          "description": "Kernel release.",
          "type": "string"
        },
        "system": {
          "description": "Operating-system name.",
          "type": "string"
        },
        "version": {
          "description": "Kernel build/version string.",
          "type": "string"
        }
      },
      "required": [
        "system",
        "release",
        "version",
        "machine"
      ],
      "type": "object"
    },
    "NativeVisualProfile": {
      "additionalProperties": false,
      "description": "Native Ghostty settings. Absent fields keep the base configuration's value.",
      "properties": {
        "background": {
          "description": "Default background as `#rrggbb`.",
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "description": "Absolute Ghostty config file replacing the isolated Ghostty-default base.",
          "type": [
            "string",
            "null"
          ]
        },
        "dpi": {
          "description": "Display DPI used by every native probe, launch, and replay; 96 when absent.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "font_family": {
          "description": "Exact installed font family; no substitute is accepted.",
          "type": [
            "string",
            "null"
          ]
        },
        "font_size_points": {
          "description": "Font size in points as an exact decimal string, such as `\"15\"` or `\"13.5\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "foreground": {
          "description": "Default foreground as `#rrggbb`.",
          "type": [
            "string",
            "null"
          ]
        },
        "padding_points": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaddingPoints"
            },
            {
              "type": "null"
            }
          ],
          "description": "Window padding in points on each side; zero is an explicit zero."
        }
      },
      "type": "object"
    },
    "PaddingPoints": {
      "additionalProperties": false,
      "description": "Symmetric window padding in points per side.",
      "properties": {
        "x": {
          "description": "Left and right padding.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Top and bottom padding.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "ProvenanceCapture": {
      "description": "How one selected provenance value is represented.",
      "oneOf": [
        {
          "const": "value",
          "description": "Retain the exact value and its hash.",
          "type": "string"
        },
        {
          "const": "hash",
          "description": "Retain only a value hash for later equality checks.",
          "type": "string"
        },
        {
          "const": "name",
          "description": "Retain only the variable name and whether it was set.",
          "type": "string"
        },
        {
          "const": "not_captured",
          "description": "Explicitly document that the selected value was not captured.",
          "type": "string"
        }
      ]
    },
    "ProvenancePolicy": {
      "additionalProperties": false,
      "description": "Explicit immutable provenance policy.",
      "properties": {
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/ProvenanceCapture"
          },
          "description": "Custom environment rules; required to be empty for built-in policies.",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ProvenancePolicyKind",
          "description": "Built-in policy behavior."
        }
      },
      "required": [
        "kind",
        "environment"
      ],
      "type": "object"
    },
    "ProvenancePolicyKind": {
      "description": "Built-in execution-provenance collection policy.",
      "oneOf": [
        {
          "const": "minimal",
          "description": "Retain only essential terminal values and inventory common locale context.",
          "type": "string"
        },
        {
          "const": "reproducible",
          "description": "Retain values needed to recreate common locale and timezone behavior.",
          "type": "string"
        },
        {
          "const": "custom",
          "description": "Apply only caller-supplied environment capture rules.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSensitivity": {
      "description": "Sensitivity classification for one provenance item.",
      "oneOf": [
        {
          "const": "public_configuration",
          "description": "Conventional terminal, locale, or timezone configuration.",
          "type": "string"
        },
        {
          "const": "potentially_sensitive",
          "description": "Caller-selected data that may contain private or proprietary content.",
          "type": "string"
        }
      ]
    },
    "RecordedVisualProfile": {
      "additionalProperties": false,
      "description": "Normalized profile committed into a canonical session manifest.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/VisualProfile",
          "description": "Normalized selected profile."
        },
        "profile_hash": {
          "description": "BLAKE3 of the compact JSON of `profile`.",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "profile_hash"
      ],
      "type": "object"
    },
    "RecorderProvenance": {
      "additionalProperties": false,
      "description": "Recorder build and binary identity.",
      "properties": {
        "binary": {
          "$ref": "#/$defs/FileProvenance",
          "description": "Running recorder binary identity."
        },
        "semantic_engine_revision": {
          "description": "Pinned semantic-engine revision.",
          "type": "string"
        },
        "source_revision": {
          "description": "Source revision embedded at build time.",
          "type": "string"
        },
        "version": {
          "description": "Package version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "source_revision",
        "semantic_engine_revision",
        "binary"
      ],
      "type": "object"
    },
    "RecordingFailurePolicy": {
      "description": "Behavior when recording fails while an owned application is still running.",
      "oneOf": [
        {
          "const": "stop",
          "description": "Stop and reap an owned test or explicitly strict recording.",
          "type": "string"
        },
        {
          "const": "preserve",
          "description": "Preserve the PTY connection and application while reporting degraded evidence.",
          "type": "string"
        }
      ]
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "Canonical runtime resource limits for one recording.",
      "properties": {
        "idle_timeout_ms": {
          "description": "Maximum idle duration in milliseconds without input, output, or control activity.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_duration_ms": {
          "description": "Maximum session duration in milliseconds before termination is triggered.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_bytes": {
          "description": "Soft output budget that triggers termination after all observed bytes are retained.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeProvenance": {
      "additionalProperties": false,
      "description": "Recorder process identity and host context.",
      "properties": {
        "effective_gid": {
          "description": "Effective group ID.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "effective_uid": {
          "description": "Effective user ID.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gid": {
          "description": "Real group ID.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kernel": {
          "$ref": "#/$defs/KernelProvenance",
          "description": "Runtime kernel identity."
        },
        "privileged": {
          "description": "Whether the effective identity is privileged root.",
          "type": "boolean"
        },
        "recorder": {
          "$ref": "#/$defs/RecorderProvenance",
          "description": "Recorder build/binary identity."
        },
        "uid": {
          "description": "Real user ID.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "umask": {
          "description": "Process umask read without modifying it, when the host exposes it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "uid",
        "effective_uid",
        "gid",
        "effective_gid",
        "privileged",
        "kernel",
        "recorder"
      ],
      "type": "object"
    },
    "SemanticPreset": {
      "description": "Bundled semantic fonts and fixed metrics.",
      "oneOf": [
        {
          "const": "bundled-v1",
          "description": "Bundled JetBrains Mono and Symbols Nerd Font faces with fixed 12x24 cells.",
          "type": "string"
        }
      ]
    },
    "SemanticVisualProfile": {
      "additionalProperties": false,
      "description": "Semantic renderer selection.",
      "properties": {
        "preset": {
          "$ref": "#/$defs/SemanticPreset",
          "description": "Bundled semantic resource preset."
        }
      },
      "required": [
        "preset"
      ],
      "type": "object"
    },
    "SessionGeometry": {
      "description": "Initial PTY geometry.",
      "properties": {
        "cols": {
          "description": "Columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pixel_height": {
          "description": "Total pixel height.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pixel_width": {
          "description": "Total pixel width.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows",
        "pixel_width",
        "pixel_height"
      ],
      "type": "object"
    },
    "SessionLineage": {
      "additionalProperties": false,
      "description": "Immutable evidence binding from a successor session to its predecessor.",
      "properties": {
        "predecessor_final_event_hash": {
          "description": "Chain root of the predecessor's final canonical event.",
          "type": "string"
        },
        "predecessor_manifest_hash": {
          "description": "BLAKE3 of the exact predecessor `session.json` bytes.",
          "type": "string"
        },
        "predecessor_session_id": {
          "description": "Canonical predecessor session identifier.",
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "description": "Stable reason for creating the successor.",
          "type": "string"
        }
      },
      "required": [
        "predecessor_session_id",
        "predecessor_manifest_hash",
        "predecessor_final_event_hash",
        "reason"
      ],
      "type": "object"
    },
    "TmuxPaneLaunchKind": {
      "description": "How the native tmux wrapper selected the command running in its child PTY.",
      "oneOf": [
        {
          "const": "default_shell",
          "description": "tmux created an ordinary pane and Termtrace restored its configured login shell.",
          "type": "string"
        },
        {
          "const": "default_command",
          "description": "tmux had a nonempty default command which Termtrace preserved through its configured shell.",
          "type": "string"
        },
        {
          "const": "explicit_argv",
          "description": "The caller supplied an exact executable and argument vector.",
          "type": "string"
        },
        {
          "const": "shell_command",
          "description": "The caller supplied one command interpreted by `/bin/sh -c`.",
          "type": "string"
        }
      ]
    },
    "TmuxPaneProvenance": {
      "additionalProperties": false,
      "description": "Immutable tmux identity captured before a Termtrace-owned pane child is spawned.",
      "properties": {
        "launch_kind": {
          "$ref": "#/$defs/TmuxPaneLaunchKind",
          "description": "How the wrapper selected the recorded child command."
        },
        "pane_height": {
          "description": "tmux pane height inherited by the child PTY.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pane_id": {
          "description": "Stable tmux pane identifier.",
          "type": "string"
        },
        "pane_index": {
          "description": "Pane index within the window at launch.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pane_pid": {
          "description": "Outer pane process identifier assigned to the Termtrace wrapper.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pane_start_command": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Exact tmux start-command display captured for diagnostics."
        },
        "pane_width": {
          "description": "tmux pane width inherited by the child PTY.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "server_pid": {
          "description": "tmux server process identifier.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "session_created_unix_seconds": {
          "description": "Unix timestamp in seconds at which tmux created the session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "Stable tmux session identifier at pane launch.",
          "type": "string"
        },
        "session_name": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Session label at pane launch; labels may change later."
        },
        "socket_path": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Exact tmux server socket path bytes."
        },
        "tmux_version": {
          "description": "tmux version reported by the server.",
          "type": "string"
        },
        "version": {
          "description": "Version of this tmux pane provenance contract.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "window_id": {
          "description": "Stable tmux window identifier at pane launch.",
          "type": "string"
        },
        "window_index": {
          "description": "Window index at pane launch.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "window_name": {
          "$ref": "#/$defs/Base64Bytes",
          "description": "Window label at pane launch; labels may change later."
        }
      },
      "required": [
        "version",
        "tmux_version",
        "socket_path",
        "server_pid",
        "session_id",
        "session_name",
        "session_created_unix_seconds",
        "window_id",
        "window_index",
        "window_name",
        "pane_id",
        "pane_index",
        "pane_pid",
        "pane_width",
        "pane_height",
        "pane_start_command",
        "launch_kind"
      ],
      "type": "object"
    },
    "VisualProfile": {
      "additionalProperties": false,
      "description": "Immutable visual configuration selected for one launch.\n\nThe native section configures Ghostty for native pixels. The semantic section selects the\nbundled semantic renderer and never changes native configuration.",
      "properties": {
        "native": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeVisualProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native Ghostty configuration; selecting it requires Ghostty and the named fonts."
        },
        "semantic": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticVisualProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Semantic renderer selection."
        },
        "version": {
          "description": "Contract version; exactly 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "WindowPadding": {
      "additionalProperties": false,
      "description": "Solver-selected Ghostty window padding in points; zero leaves the profile's own padding in\neffect.",
      "properties": {
        "x": {
          "description": "Horizontal padding on each side.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Vertical padding on each side.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable provenance written before the child is spawned.",
  "properties": {
    "architecture": {
      "description": "Build target architecture.",
      "type": "string"
    },
    "child_environment": {
      "$ref": "#/$defs/ChildEnvironmentPolicy",
      "description": "Value-free child-environment policy; selected values live in execution provenance."
    },
    "command": {
      "description": "Exact executable and argument bytes.",
      "items": {
        "$ref": "#/$defs/Base64Bytes"
      },
      "type": "array"
    },
    "contains_sensitive_terminal_data": {
      "description": "Explicit sensitivity warning.",
      "type": "boolean"
    },
    "control_socket": {
      "description": "Linux abstract control-socket name for the live recorder.",
      "type": "string"
    },
    "creation_alias": {
      "description": "Friendly alias supplied at creation, never used as canonical identity.",
      "type": [
        "string",
        "null"
      ]
    },
    "durability_policy": {
      "$ref": "#/$defs/DurabilityPolicy",
      "description": "Chain-bound output persistence policy."
    },
    "event_log": {
      "description": "Canonical event-log relative path.",
      "type": "string"
    },
    "execution_provenance": {
      "$ref": "#/$defs/ExecutionProvenance",
      "description": "Sensitivity-aware execution provenance and its explicit collection policy."
    },
    "failure_policy": {
      "$ref": "#/$defs/RecordingFailurePolicy",
      "default": "stop",
      "description": "Explicit application-lifecycle policy for recorder failures."
    },
    "format": {
      "description": "Stable format identifier.",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/SessionGeometry",
      "description": "Initial PTY geometry."
    },
    "geometry_provenance": {
      "$ref": "#/$defs/GeometryProvenance",
      "default": {
        "capture_target": null,
        "source": "manual"
      },
      "description": "Selection source and optional capture target for the initial geometry."
    },
    "ghostty_visual": {
      "anyOf": [
        {
          "$ref": "#/$defs/GhosttyVisualProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical per-recording Ghostty profile, when explicitly resolved."
    },
    "import_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional provenance when this session canonically imports a byte stream."
    },
    "lineage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionLineage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Evidence-bound predecessor when this session is an immutable successor."
    },
    "operating_system": {
      "description": "Build target operating system.",
      "type": "string"
    },
    "request_journal": {
      "description": "Persistent mutation deduplication journal relative path.",
      "type": "string"
    },
    "resource_limits": {
      "$ref": "#/$defs/ResourceLimits",
      "description": "Chain-bound runtime resource limits."
    },
    "session_id": {
      "description": "Session identifier shared with the event log.",
      "format": "uuid",
      "type": "string"
    },
    "started_unix_ns": {
      "description": "Unix wall-clock origin in nanoseconds.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "termtrace_version": {
      "description": "Termtrace package version.",
      "type": "string"
    },
    "tmux_pane": {
      "anyOf": [
        {
          "$ref": "#/$defs/TmuxPaneProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "tmux pane identity when this command was launched through native tmux recording."
    },
    "version": {
      "description": "Schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "visual_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordedVisualProfile"
        },
        {
          "type": "null"
        }
      ],
      "description": "Visual profile selected at launch; absent for legacy launches using ambient defaults."
    },
    "working_directory": {
      "anyOf": [
        {
          "$ref": "#/$defs/Base64Bytes"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact effective working-directory bytes, when the launch context can provide them."
    }
  },
  "required": [
    "format",
    "version",
    "session_id",
    "started_unix_ns",
    "command",
    "geometry",
    "child_environment",
    "execution_provenance",
    "termtrace_version",
    "operating_system",
    "architecture",
    "event_log",
    "control_socket",
    "request_journal",
    "contains_sensitive_terminal_data",
    "durability_policy",
    "resource_limits"
  ],
  "title": "SessionManifest",
  "type": "object"
}
