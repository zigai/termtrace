{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "CaptureTarget": {
      "description": "Pixel viewport intended for native visual capture.",
      "properties": {
        "height": {
          "description": "Viewport height in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Viewport width in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "DurabilityMode": {
      "description": "Output persistence behavior selected for one canonical recording.",
      "oneOf": [
        {
          "const": "strict",
          "description": "Synchronize every PTY output event before processing continues.",
          "type": "string"
        },
        {
          "const": "bounded",
          "description": "Synchronize after a configured output-byte or elapsed-time threshold.",
          "type": "string"
        },
        {
          "const": "throughput",
          "description": "Buffer PTY output until a mutation, lifecycle, or completion boundary.",
          "type": "string"
        }
      ]
    },
    "DurabilityPolicy": {
      "additionalProperties": false,
      "description": "Chain-bound configuration for canonical output persistence.",
      "properties": {
        "maximum_interval_ms": {
          "description": "Maximum uncommitted interval for bounded mode.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maximum_uncommitted_bytes": {
          "description": "Maximum uncommitted PTY bytes for bounded mode.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/DurabilityMode",
          "description": "Selected persistence behavior."
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "GeometryProvenance": {
      "description": "Provenance for automatic terminal geometry selection.",
      "properties": {
        "capture_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTarget"
            },
            {
              "type": "null"
            }
          ],
          "description": "Intended native-capture viewport, when selected during recording."
        },
        "ghostty_config_hash": {
          "description": "Effective Ghostty configuration hash used for a fitted measurement.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/GeometrySource",
          "description": "How the initial geometry was selected."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "GeometrySource": {
      "description": "Origin of the initial terminal geometry.",
      "oneOf": [
        {
          "const": "manual",
          "description": "Explicit columns, rows, and cell dimensions.",
          "type": "string"
        },
        {
          "const": "inherited",
          "description": "Dimensions inherited from the controlling terminal.",
          "type": "string"
        },
        {
          "const": "ghostty_fit",
          "description": "Dimensions measured from Ghostty at a target viewport size.",
          "type": "string"
        }
      ]
    },
    "GhosttyVisualOverrides": {
      "description": "Focused Termtrace overrides applied to a Ghostty visual profile.",
      "properties": {
        "background": {
          "description": "Default background color in Ghostty syntax.",
          "type": [
            "string",
            "null"
          ]
        },
        "font_family": {
          "description": "Regular terminal font family.",
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "description": "Font size in points, represented exactly as a Ghostty config value.",
          "type": [
            "string",
            "null"
          ]
        },
        "foreground": {
          "description": "Default foreground color in Ghostty syntax.",
          "type": [
            "string",
            "null"
          ]
        },
        "padding_x": {
          "description": "Symmetric horizontal window padding in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "padding_y": {
          "description": "Symmetric vertical window padding in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GhosttyVisualProvenance": {
      "description": "Persisted provenance for a canonical per-recording Ghostty profile.",
      "properties": {
        "effective_config": {
          "description": "Relative canonical effective-configuration artifact.",
          "type": "string"
        },
        "effective_config_hash": {
          "description": "BLAKE3 of the canonical effective configuration.",
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/GhosttyVisualOverrides",
          "description": "Focused overrides applied after resolving the source configuration."
        },
        "source_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/Base64Bytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original custom configuration path bytes, when supplied."
        }
      },
      "required": [
        "overrides",
        "effective_config",
        "effective_config_hash"
      ],
      "type": "object"
    },
    "SessionGeometry": {
      "description": "Initial PTY geometry.",
      "properties": {
        "cols": {
          "description": "Columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pixel_height": {
          "description": "Total pixel height.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pixel_width": {
          "description": "Total pixel width.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows",
        "pixel_width",
        "pixel_height"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable provenance written before the child is spawned.",
  "properties": {
    "architecture": {
      "description": "Build target architecture.",
      "type": "string"
    },
    "child_environment": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Allowlisted child environment overrides.",
      "type": "object"
    },
    "command": {
      "description": "Exact executable and argument bytes.",
      "items": {
        "$ref": "#/$defs/Base64Bytes"
      },
      "type": "array"
    },
    "contains_sensitive_terminal_data": {
      "description": "Explicit sensitivity warning.",
      "type": "boolean"
    },
    "control_socket": {
      "description": "Live control socket relative path.",
      "type": "string"
    },
    "durability_policy": {
      "$ref": "#/$defs/DurabilityPolicy",
      "description": "Chain-bound output persistence policy."
    },
    "event_log": {
      "description": "Canonical event-log relative path.",
      "type": "string"
    },
    "format": {
      "description": "Stable format identifier.",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/SessionGeometry",
      "description": "Initial PTY geometry."
    },
    "geometry_provenance": {
      "$ref": "#/$defs/GeometryProvenance",
      "default": {
        "capture_target": null,
        "ghostty_config_hash": null,
        "source": "manual"
      },
      "description": "Selection source and optional capture target for the initial geometry."
    },
    "ghostty_visual": {
      "anyOf": [
        {
          "$ref": "#/$defs/GhosttyVisualProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical per-recording Ghostty profile, when explicitly resolved."
    },
    "operating_system": {
      "description": "Build target operating system.",
      "type": "string"
    },
    "session_id": {
      "description": "Session identifier shared with the event log.",
      "format": "uuid",
      "type": "string"
    },
    "started_unix_ns": {
      "description": "Unix wall-clock origin in nanoseconds.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "termtrace_version": {
      "description": "Termtrace package version.",
      "type": "string"
    },
    "version": {
      "description": "Schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "working_directory": {
      "anyOf": [
        {
          "$ref": "#/$defs/Base64Bytes"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact effective working-directory bytes; absent only in legacy sessions."
    }
  },
  "required": [
    "format",
    "version",
    "session_id",
    "started_unix_ns",
    "command",
    "geometry",
    "child_environment",
    "termtrace_version",
    "operating_system",
    "architecture",
    "event_log",
    "control_socket",
    "contains_sensitive_terminal_data",
    "durability_policy"
  ],
  "title": "SessionManifest",
  "type": "object"
}
