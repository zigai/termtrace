{
  "$defs": {
    "SourceRange": {
      "description": "A non-empty half-open interval on the canonical monotonic timeline.",
      "properties": {
        "end_monotonic_ns": {
          "description": "Exclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_monotonic_ns",
        "end_monotonic_ns"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/visual-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Provenance and probe evidence for native visual artifacts.",
  "properties": {
    "capture_started_unix_ns": {
      "description": "Wall-clock time used as approximate video frame zero.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "ffmpeg_version": {
      "description": "`FFmpeg` version first line.",
      "type": "string"
    },
    "fps": {
      "description": "Video frame rate.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "ghostty_config_hash": {
      "description": "BLAKE3 of Ghostty's resolved configuration.",
      "type": "string"
    },
    "ghostty_overrides": {
      "description": "Exact headless launch overrides.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ghostty_version": {
      "description": "Installed Ghostty version report.",
      "type": "string"
    },
    "height": {
      "description": "Capture height.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "replay_origin_unix_ns": {
      "description": "Playback event-time origin.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "screenshot_probe": {
      "description": "Parsed `FFprobe` screenshot evidence."
    },
    "session_id": {
      "description": "Source session identifier.",
      "format": "uuid",
      "type": "string"
    },
    "source_event_hash": {
      "description": "Terminal hash of the source event log.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "Selected half-open source interval, absent for a full-session capture."
    },
    "version": {
      "description": "Manifest schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "video_probe": {
      "description": "Parsed `FFprobe` video evidence."
    },
    "width": {
      "description": "Capture width.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "fps",
    "width",
    "height",
    "capture_started_unix_ns",
    "replay_origin_unix_ns",
    "ghostty_config_hash",
    "ghostty_version",
    "ffmpeg_version",
    "ghostty_overrides",
    "video_probe",
    "screenshot_probe"
  ],
  "title": "VisualManifest",
  "type": "object"
}
