{
  "$defs": {
    "ArtifactMember": {
      "additionalProperties": false,
      "description": "Whole-file integrity metadata embedded in a derived manifest.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of the complete file.",
          "type": "string"
        },
        "byte_length": {
          "description": "Exact byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "Stable media type.",
          "type": "string"
        },
        "path": {
          "description": "Normalized relative path below the artifact directory.",
          "type": "string"
        },
        "relationship": {
          "description": "Relationship to the derivation.",
          "type": "string"
        },
        "schema_type": {
          "description": "Public schema identifier, when the file is structured data.",
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Sensitivity classification."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "NativeFrameSample": {
      "additionalProperties": false,
      "description": "One directly captured native frame sample.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 of exact PNG bytes.",
          "type": "string"
        },
        "captured_unix_ns": {
          "description": "Capture wall-clock timestamp.",
          "format": "uint128",
          "minimum": 0,
          "type": "integer"
        },
        "same_as_previous": {
          "description": "Whether this sample equals its immediate predecessor.",
          "type": "boolean"
        },
        "sample": {
          "description": "Zero-based sample number.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sample",
        "captured_unix_ns",
        "blake3",
        "same_as_previous"
      ],
      "type": "object"
    },
    "SourceRange": {
      "description": "A non-empty half-open interval on the canonical monotonic timeline.",
      "properties": {
        "end_monotonic_ns": {
          "description": "Exclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_monotonic_ns": {
          "description": "Inclusive source timestamp in nanoseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_monotonic_ns",
        "end_monotonic_ns"
      ],
      "type": "object"
    },
    "StateSelection": {
      "description": "Semantic states retained in one derived index.",
      "oneOf": [
        {
          "const": "all",
          "description": "Retain every distinct state, including synchronized-output internals.",
          "type": "string"
        },
        {
          "const": "presented",
          "description": "Retain only states eligible for presentation by a native terminal.",
          "type": "string"
        }
      ]
    },
    "TerminalGeometryReport": {
      "description": "Geometry reported by a live terminal through XTWINOPS queries.",
      "properties": {
        "cell_height": {
          "description": "Height of one rendered cell in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cell_width": {
          "description": "Width of one rendered cell in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cols": {
          "description": "Terminal columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Terminal rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text_height": {
          "description": "Height of the complete text area in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text_width": {
          "description": "Width of the complete text area in pixels.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows",
        "cell_width",
        "cell_height",
        "text_width",
        "text_height"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/visual-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provenance and probe evidence for native visual artifacts.",
  "properties": {
    "capture_kind": {
      "description": "`video` or `screenshot`.",
      "type": "string"
    },
    "capture_started_unix_ns": {
      "description": "Wall-clock time used as approximate video frame zero.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "effective_config_hash": {
      "description": "BLAKE3 of the exact effective configuration captured as a manifest member.",
      "type": "string"
    },
    "endpoint_event_byte_offset": {
      "description": "Inclusive endpoint byte offset within an output event.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "endpoint_event_seq": {
      "description": "Exact endpoint event for direct screenshots.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ffmpeg_version": {
      "description": "`FFmpeg` version first line.",
      "type": [
        "string",
        "null"
      ]
    },
    "fps": {
      "description": "Video frame rate.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "frame_samples": {
      "description": "Ordered native frame samples used for stability evidence.",
      "items": {
        "$ref": "#/$defs/NativeFrameSample"
      },
      "type": "array"
    },
    "geometry_report": {
      "$ref": "#/$defs/TerminalGeometryReport",
      "description": "Parent-side Ghostty geometry preflight at the capture viewport."
    },
    "ghostty_overrides": {
      "description": "Exact headless launch overrides.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ghostty_version": {
      "description": "Installed Ghostty version report.",
      "type": "string"
    },
    "guarantee_level": {
      "description": "Honest native resource guarantee level.",
      "type": "string"
    },
    "height": {
      "description": "Capture height.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "members": {
      "description": "Whole-file integrity and classification for every payload member.",
      "items": {
        "$ref": "#/$defs/ArtifactMember"
      },
      "type": "array"
    },
    "presentation_evidence": {
      "description": "Parser barrier and native frame-stability guarantee label.",
      "type": "string"
    },
    "replay_origin_unix_ns": {
      "description": "Playback event-time origin.",
      "format": "uint128",
      "minimum": 0,
      "type": "integer"
    },
    "screenshot_probe": {
      "description": "Parsed `FFprobe` screenshot evidence."
    },
    "selected_state_hash": {
      "description": "Exact selected semantic state hash for direct screenshots.",
      "type": [
        "string",
        "null"
      ]
    },
    "selected_state_id": {
      "description": "Exact selected state identifier for direct screenshots.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "session_id": {
      "description": "Source session identifier.",
      "format": "uuid",
      "type": "string"
    },
    "source_event_hash": {
      "description": "Terminal hash of the source event log.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "Selected half-open source interval, absent for a full-session capture."
    },
    "state_selection": {
      "$ref": "#/$defs/StateSelection",
      "description": "Semantic index retention mode used for frame mapping."
    },
    "version": {
      "description": "Manifest schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "video_probe": {
      "description": "Parsed `FFprobe` video evidence."
    },
    "width": {
      "description": "Capture width.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "state_selection",
    "geometry_report",
    "fps",
    "width",
    "height",
    "capture_started_unix_ns",
    "replay_origin_unix_ns",
    "effective_config_hash",
    "ghostty_version",
    "ghostty_overrides",
    "screenshot_probe",
    "members",
    "capture_kind",
    "presentation_evidence",
    "frame_samples",
    "guarantee_level"
  ],
  "title": "VisualManifest",
  "type": "object"
}
