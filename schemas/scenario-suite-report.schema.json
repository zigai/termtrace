{
  "$defs": {
    "ExactPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      ],
      "x-termtrace-path": true
    },
    "ScenarioAttemptReport": {
      "additionalProperties": false,
      "description": "One fresh-session attempt retained within a scenario suite result.",
      "properties": {
        "attempt": {
          "description": "One-based attempt number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "duration_ms": {
          "description": "Wall-clock duration including cleanup and evidence publication, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "report": {
          "$ref": "#/$defs/ScenarioReport",
          "description": "Complete fresh-session result."
        }
      },
      "required": ["attempt", "duration_ms", "report"],
      "type": "object"
    },
    "ScenarioCaseReport": {
      "additionalProperties": false,
      "description": "Every attempt for one selected scenario document.",
      "properties": {
        "attempts": {
          "description": "Ordered fresh-session attempts, including failed attempts before a pass.",
          "items": {
            "$ref": "#/$defs/ScenarioAttemptReport"
          },
          "type": "array"
        },
        "scenario": {
          "$ref": "#/$defs/ExactPath",
          "description": "Input scenario document path."
        },
        "status": {
          "$ref": "#/$defs/ScenarioCaseStatus",
          "description": "Factual verdict, independent of exit policy."
        }
      },
      "required": ["scenario", "status", "attempts"],
      "type": "object"
    },
    "ScenarioCaseStatus": {
      "description": "Factual verdict for a selected case.",
      "oneOf": [
        {
          "const": "passed",
          "description": "First attempt passed.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "Expectation failures followed by a pass.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Exhausted expectation failures or infrastructure failure.",
          "type": "string"
        }
      ]
    },
    "ScenarioFailure": {
      "additionalProperties": false,
      "description": "Stable failure context for one scenario step.",
      "properties": {
        "message": {
          "description": "Safe diagnostic without child environment values.",
          "type": "string"
        },
        "request_ids": {
          "description": "Caller-owned mutation identifiers allocated before the failure.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "step_index": {
          "description": "Zero-based failed step index.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "step_kind": {
          "description": "Stable scenario step kind.",
          "type": "string"
        }
      },
      "required": ["step_index", "step_kind", "request_ids", "message"],
      "type": "object"
    },
    "ScenarioInfrastructureError": {
      "additionalProperties": false,
      "description": "Safe structured infrastructure diagnostic. No child output or environment values.",
      "properties": {
        "code": {
          "description": "Stable machine-readable error code.",
          "type": "string"
        },
        "message": {
          "description": "Safe bounded explanation.",
          "type": "string"
        },
        "phase": {
          "description": "Lifecycle or reporting phase.",
          "type": "string"
        }
      },
      "required": ["phase", "code", "message"],
      "type": "object"
    },
    "ScenarioReport": {
      "additionalProperties": false,
      "description": "Machine-readable scenario outcome.",
      "properties": {
        "artifact_warnings": {
          "description": "Optional evidence derivations that could not be produced.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "canonical_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Owner-only canonical evidence path, absent for prelaunch failures."
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "First failure, if any."
        },
        "failure_artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Atomic failure evidence directory, only after successful publication."
        },
        "infrastructure_errors": {
          "description": "Ordered required infrastructure failures, including secondary cleanup errors.",
          "items": {
            "$ref": "#/$defs/ScenarioInfrastructureError"
          },
          "type": "array"
        },
        "name": {
          "description": "Scenario name.",
          "type": "string"
        },
        "session_id": {
          "description": "Immutable canonical session identity, absent when launch never returned a session.",
          "format": "uuid",
          "type": ["string", "null"]
        },
        "status": {
          "$ref": "#/$defs/ScenarioStatus",
          "description": "Overall disposition."
        },
        "steps": {
          "description": "Successfully completed steps.",
          "items": {
            "$ref": "#/$defs/ScenarioStepResult"
          },
          "type": "array"
        },
        "version": {
          "description": "Scenario report contract version (independent of documents).",
          "format": "uint32",
          "maximum": 3,
          "minimum": 3,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "name",
        "status",
        "steps",
        "infrastructure_errors",
        "artifact_warnings"
      ],
      "type": "object"
    },
    "ScenarioStatus": {
      "description": "Overall scenario disposition.",
      "oneOf": [
        {
          "const": "passed",
          "description": "Every step completed successfully.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "One step failed and later steps did not run.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Infrastructure prevented trustworthy completion.",
          "type": "string"
        }
      ]
    },
    "ScenarioStepResult": {
      "additionalProperties": false,
      "description": "One executed step and its canonical provenance.",
      "properties": {
        "index": {
          "description": "Zero-based step index.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "Stable scenario step kind.",
          "type": "string"
        },
        "request_ids": {
          "description": "Caller-owned mutation request identifiers used by this step.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "state_hash": {
          "description": "Matched presented state hash when applicable.",
          "type": ["string", "null"]
        }
      },
      "required": ["index", "kind", "request_ids"],
      "type": "object"
    },
    "ScenarioSuiteStatus": {
      "description": "Overall multi-scenario disposition.",
      "oneOf": [
        {
          "const": "passed",
          "description": "Every selected scenario passed on its first attempt.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "Some expectation failures recovered, with no infrastructure errors.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "At least one case exhausted its attempts, or infrastructure/reporting failed.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/scenario-suite-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-readable sharded, bounded-concurrency scenario suite result.",
  "properties": {
    "cases": {
      "description": "Ordered selected scenarios and their retained attempts.",
      "items": {
        "$ref": "#/$defs/ScenarioCaseReport"
      },
      "type": "array"
    },
    "duration_ms": {
      "description": "Wall-clock suite duration in milliseconds (not summed worker time).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "fail_on_flaky": {
      "description": "Effective policy: recovered expectation failures make CI fail when true.",
      "type": "boolean"
    },
    "infrastructure_errors": {
      "description": "Ordered suite-level reporting/orchestration errors.",
      "items": {
        "$ref": "#/$defs/ScenarioInfrastructureError"
      },
      "type": "array"
    },
    "jobs": {
      "description": "Requested maximum worker count.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "shard_count": {
      "description": "Optional total shard count.",
      "format": "uint",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "shard_index": {
      "description": "Optional zero-based shard index.",
      "format": "uint",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "status": {
      "$ref": "#/$defs/ScenarioSuiteStatus",
      "description": "Overall disposition."
    },
    "version": {
      "description": "Suite result contract version.",
      "format": "uint32",
      "maximum": 2,
      "minimum": 2,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "status",
    "duration_ms",
    "fail_on_flaky",
    "infrastructure_errors",
    "jobs",
    "cases"
  ],
  "title": "ScenarioSuiteReport",
  "type": "object"
}
