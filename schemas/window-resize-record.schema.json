{
  "$defs": {
    "CellGrid": {
      "additionalProperties": false,
      "description": "Terminal grid in cells.",
      "properties": {
        "cols": {
          "description": "Columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "DecimalU64": {
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string",
      "x-termtrace-native-integer": "uint64"
    },
    "WindowResizeDecision": {
      "description": "Supervisor answer to one window-resize request.",
      "oneOf": [
        {
          "const": "configured",
          "description": "The window was configured; the grid change is observed separately.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The window was not touched.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/window-resize-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One line of `window-resizes.jsonl`: the window-rect timeline of a capture.\n\nThe video canvas never changes; this records where the terminal window sat inside it.\nNo presentation claim is made about when a frame shows the new grid.",
  "properties": {
    "code": {
      "description": "Stable rejection code.",
      "type": [
        "string",
        "null"
      ]
    },
    "configured_unix_ns": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecimalU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wall-clock time of the configure request."
    },
    "decision": {
      "$ref": "#/$defs/WindowResizeDecision",
      "description": "Whether the window was configured."
    },
    "event_seq": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecimalU64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical `resize_intent` event carrying this request identity."
    },
    "observed": {
      "anyOf": [
        {
          "$ref": "#/$defs/CellGrid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Grid observed on the captured terminal's PTY after configuration."
    },
    "request_id": {
      "description": "Caller request identity, shared with the canonical resize events.",
      "format": "uuid",
      "type": "string"
    },
    "requested": {
      "$ref": "#/$defs/CellGrid",
      "description": "Requested grid."
    },
    "window_height": {
      "description": "Configured window height in pixels, including Ghostty's window overhead.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "window_width": {
      "description": "Configured window width in pixels, including Ghostty's window overhead.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "request_id",
    "requested",
    "decision"
  ],
  "title": "WindowResizeRecord",
  "type": "object"
}
