{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "DiagnosticCheck": {
      "description": "Stable detector selectable by `diagnose --check`.",
      "oneOf": [
        {
          "const": "full_redraw",
          "description": "Full-viewport semantic clear controls.",
          "type": "string"
        },
        {
          "const": "transient",
          "description": "Ordered presented or hidden transient states.",
          "type": "string"
        },
        {
          "const": "dirty",
          "description": "Semantic changes inconsistent with Ghostty dirty evidence.",
          "type": "string"
        },
        {
          "const": "cursor",
          "description": "Large cursor movement between semantic boundaries.",
          "type": "string"
        },
        {
          "const": "modes",
          "description": "Repeated terminal-mode mutations.",
          "type": "string"
        },
        {
          "const": "palette",
          "description": "Repeated palette/default-color mutations.",
          "type": "string"
        },
        {
          "const": "query_loop",
          "description": "Repeated equal query/response exchanges.",
          "type": "string"
        },
        {
          "const": "effects",
          "description": "Control strings the semantic engine ignored and processing errors it reported.",
          "type": "string"
        }
      ]
    },
    "DiagnosticFinding": {
      "additionalProperties": false,
      "description": "One conservative session-wide diagnostic finding.",
      "properties": {
        "code": {
          "description": "Stable machine-readable finding code.",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/FindingConfidence",
          "description": "Conservative confidence label."
        },
        "facts": {
          "description": "Exact neutral facts and limitations.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "native_correlations": {
          "description": "Native relationships, if independently available.",
          "items": {
            "$ref": "#/$defs/NativeCorrelation"
          },
          "type": "array"
        },
        "state_ids": {
          "description": "Supporting semantic state IDs.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "token_ids": {
          "description": "Supporting VT token IDs.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "confidence",
        "state_ids",
        "token_ids",
        "facts",
        "native_correlations"
      ],
      "type": "object"
    },
    "ExactPath": {
      "allOf": [
        {
          "$ref": "#/$defs/PathValue"
        }
      ],
      "x-termtrace-path": true
    },
    "FindingConfidence": {
      "description": "Conservative confidence label for a derived finding.",
      "oneOf": [
        {
          "const": "high",
          "description": "Directly encoded control and semantic outcome agree.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Ordered facts support a candidate but do not prove user perception.",
          "type": "string"
        }
      ]
    },
    "NativeCorrelation": {
      "additionalProperties": false,
      "description": "One source-bound relationship to a native artifact.",
      "properties": {
        "frame": {
          "description": "Nominal encoded frame when clock mapping supplied one.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "level": {
          "$ref": "#/$defs/NativeEvidenceLevel",
          "description": "Honest evidence level."
        },
        "limitation": {
          "description": "Exact limitation on the relationship.",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ExactPath",
          "description": "Relative native manifest path."
        },
        "state_id": {
          "description": "Related semantic state.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "level",
        "manifest",
        "state_id",
        "limitation"
      ],
      "type": "object"
    },
    "NativeEvidenceLevel": {
      "description": "Strength of evidence relating a semantic finding to native presentation.",
      "oneOf": [
        {
          "const": "presentation_eligible",
          "description": "The semantic state was eligible for terminal presentation.",
          "type": "string"
        },
        {
          "const": "scheduled_for_frame",
          "description": "Clock-map arithmetic assigned the state a nominal video frame.",
          "type": "string"
        },
        {
          "const": "post_endpoint_stable_capture",
          "description": "A stable native frame was captured after replay reached this endpoint.",
          "type": "string"
        },
        {
          "const": "frame_observed",
          "description": "A causal presentation mechanism verified actual captured output.",
          "type": "string"
        }
      ]
    },
    "OmittedFindings": {
      "additionalProperties": false,
      "description": "Count of detected findings of one code that a report does not list.",
      "properties": {
        "code": {
          "description": "Stable machine-readable finding code.",
          "type": "string"
        },
        "count": {
          "description": "Detected findings with this code beyond the listed ones.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "code",
        "count"
      ],
      "type": "object"
    },
    "OutputPage": {
      "additionalProperties": false,
      "description": "Deterministic page coordinates for one ordered collection.",
      "properties": {
        "limit": {
          "description": "Requested maximum, or none when every remaining item was requested.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "next_offset": {
          "description": "Offset for the next page when more items remain.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Effective zero-based offset, clamped to the collection length.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "returned": {
          "description": "Number of items included in this response.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Complete matching collection length when pagination reaches closure.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "description": "Whether more matching items remain after this page.",
          "type": "boolean"
        }
      },
      "required": [
        "offset",
        "returned",
        "truncated"
      ],
      "type": "object"
    },
    "PathValue": {
      "anyOf": [
        {
          "description": "A path that is valid UTF-8.",
          "type": "string"
        },
        {
          "description": "A path whose bytes are not valid UTF-8.",
          "properties": {
            "base64": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact path bytes encoded as Base64."
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        }
      ],
      "description": "One exact filesystem path in text output."
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/diagnose-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic report from conservative session-wide detectors.",
  "properties": {
    "broad_change_fraction": {
      "description": "Minimum changed-cell fraction used for broad redraw findings.",
      "type": "string"
    },
    "checks": {
      "description": "Ordered detector selection.",
      "items": {
        "$ref": "#/$defs/DiagnosticCheck"
      },
      "type": "array"
    },
    "findings": {
      "description": "Deterministic findings.",
      "items": {
        "$ref": "#/$defs/DiagnosticFinding"
      },
      "type": "array"
    },
    "format": {
      "description": "Stable report format.",
      "type": "string"
    },
    "omitted_findings": {
      "description": "Findings that were detected but not listed because their code reached the listing bound.",
      "items": {
        "$ref": "#/$defs/OmittedFindings"
      },
      "type": "array"
    },
    "output_page": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutputPage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Page coordinates when CLI output intentionally contains a bounded subset."
    },
    "session_id": {
      "description": "Canonical session identity.",
      "format": "uuid",
      "type": "string"
    },
    "source_event_count": {
      "description": "Canonical event count anchoring the report.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "source_final_event_hash": {
      "description": "Final canonical event hash anchoring the report.",
      "type": "string"
    },
    "version": {
      "description": "Report schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "session_id",
    "source_final_event_hash",
    "source_event_count",
    "checks",
    "broad_change_fraction",
    "findings",
    "omitted_findings"
  ],
  "title": "DiagnoseReport",
  "type": "object"
}
