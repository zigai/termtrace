{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "CanonicalBoundary": {
      "additionalProperties": false,
      "description": "Actor-consistent position in the canonical event stream.",
      "properties": {
        "event_hash": {
          "description": "Hash of the preceding event, or the event header at sequence zero.",
          "type": "string"
        },
        "next_event_seq": {
          "description": "Sequence number that will be assigned to the next event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "PTY output bytes included through this boundary.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "next_event_seq",
        "event_hash",
        "output_bytes"
      ],
      "type": "object"
    },
    "CaptureQuality": {
      "description": "How settled the observed state is.",
      "oneOf": [
        {
          "const": "live",
          "description": "Immediate state from a responsive live actor.",
          "type": "string"
        },
        {
          "const": "stable",
          "description": "Live state proven unchanged for a requested interval.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "State from validated completed evidence.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Explicitly incomplete validated prefix.",
          "type": "string"
        }
      ]
    },
    "ModeState": {
      "description": "Terminal modes relevant to presentation and input.",
      "properties": {
        "alternate_screen": {
          "description": "Any alternate-screen mode.",
          "type": "boolean"
        },
        "bracketed_paste": {
          "description": "DEC bracketed-paste mode 2004.",
          "type": "boolean"
        },
        "synchronized_output": {
          "description": "DEC synchronized-output mode 2026.",
          "type": "boolean"
        },
        "values": {
          "description": "Complete stable inventory of known ANSI and DEC modes.",
          "items": {
            "$ref": "#/$defs/TerminalMode"
          },
          "type": "array"
        },
        "wraparound": {
          "description": "DEC auto-wrap mode 7.",
          "type": "boolean"
        }
      },
      "required": [
        "synchronized_output",
        "alternate_screen",
        "wraparound",
        "bracketed_paste",
        "values"
      ],
      "type": "object"
    },
    "ObservationFrame": {
      "additionalProperties": false,
      "description": "Compact stable frame shared by CLI and clients.",
      "properties": {
        "cols": {
          "description": "Terminal columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cursor_column": {
          "description": "Cursor column when it lies in the viewport.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cursor_row": {
          "description": "Cursor row when it lies in the viewport.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cursor_visible": {
          "description": "Whether the cursor is visible.",
          "type": "boolean"
        },
        "modes": {
          "$ref": "#/$defs/ModeState",
          "description": "Stable terminal-mode facts."
        },
        "rows": {
          "description": "Terminal rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "viewport_text": {
          "description": "Plain text for the complete viewport.",
          "type": "string"
        }
      },
      "required": [
        "viewport_text",
        "cols",
        "rows",
        "cursor_visible",
        "modes"
      ],
      "type": "object"
    },
    "ObservationIntegrity": {
      "description": "Integrity relationship between an observation and canonical evidence.",
      "oneOf": [
        {
          "const": "canonical_chained",
          "description": "State derives from a validated canonical hash chain or live actor boundary.",
          "type": "string"
        },
        {
          "const": "unchained",
          "description": "State derives from an unchained byte stream.",
          "type": "string"
        }
      ]
    },
    "ObservationResolution": {
      "description": "Service path used to resolve an observation without changing its meaning.",
      "oneOf": [
        {
          "const": "actor_snapshot",
          "description": "Actor-consistent live snapshot fast path.",
          "type": "string"
        },
        {
          "const": "canonical_replay",
          "description": "Independently validated canonical event replay.",
          "type": "string"
        },
        {
          "const": "validated_checkpoint",
          "description": "Content-addressed full-state checkpoint validated against exact source bytes.",
          "type": "string"
        },
        {
          "const": "ansi_interpretation",
          "description": "Pinned semantic interpretation of an unchained ANSI stream.",
          "type": "string"
        }
      ]
    },
    "ObservationSourceKind": {
      "description": "Source category for one observation.",
      "oneOf": [
        {
          "const": "live_session",
          "description": "Responsive canonical recording actor.",
          "type": "string"
        },
        {
          "const": "completed_session",
          "description": "Validated completed canonical recording.",
          "type": "string"
        },
        {
          "const": "interrupted_session",
          "description": "Explicitly validated but incomplete canonical event prefix.",
          "type": "string"
        },
        {
          "const": "ansi_stream",
          "description": "Unchained ANSI/VT byte stream.",
          "type": "string"
        },
        {
          "const": "imported_ansi",
          "description": "Completed canonical evidence imported from an ANSI/VT byte stream.",
          "type": "string"
        },
        {
          "const": "one_off_command",
          "description": "Canonical recording allocated for a one-off command.",
          "type": "string"
        }
      ]
    },
    "StatePoint": {
      "description": "Shared state selection vocabulary.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Latest presentation-eligible state.",
          "properties": {
            "selector": {
              "const": "latest_presented",
              "type": "string"
            }
          },
          "required": [
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Stream position of the state: output bytes and applied resizes before it.",
          "properties": {
            "selector": {
              "const": "state_id",
              "type": "string"
            },
            "state_id": {
              "description": "Stream position of the state: output bytes and applied resizes before it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "selector",
            "state_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Latest state with this content hash.",
          "properties": {
            "selector": {
              "const": "state_hash",
              "type": "string"
            },
            "state_hash": {
              "description": "BLAKE3 hash of the complete normalized semantic state.",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "state_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Latest state at or before an event sequence.",
          "properties": {
            "event_seq": {
              "description": "Canonical event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "selector": {
              "const": "event_seq",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "event_seq"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Latest state at or before a session-monotonic timestamp.",
          "properties": {
            "monotonic_ns": {
              "description": "Session-monotonic nanoseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "selector": {
              "const": "monotonic_ns",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "monotonic_ns"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "State at a uniquely named marker.",
          "properties": {
            "label": {
              "description": "Unique marker label.",
              "type": "string"
            },
            "selector": {
              "const": "marker",
              "type": "string"
            }
          },
          "required": [
            "selector",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "TerminalMode": {
      "description": "One ANSI or DEC mode value.",
      "properties": {
        "ansi": {
          "description": "`true` for ANSI mode, `false` for DEC-private mode.",
          "type": "boolean"
        },
        "enabled": {
          "description": "Current set/reset value.",
          "type": "boolean"
        },
        "number": {
          "description": "Numeric mode identifier.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "number",
        "ansi",
        "enabled"
      ],
      "type": "object"
    },
    "TruthLayer": {
      "description": "Rendering truth represented by an observation.",
      "oneOf": [
        {
          "const": "semantic",
          "description": "Pinned semantic-engine state.",
          "type": "string"
        },
        {
          "const": "native",
          "description": "Pixels captured from the native terminal renderer.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Truth-labeled observation of one terminal state.",
  "properties": {
    "boundary": {
      "$ref": "#/$defs/CanonicalBoundary",
      "description": "Source boundary observed or validated."
    },
    "canonical_session": {
      "anyOf": [
        {
          "$ref": "#/$defs/Base64Bytes"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact canonical session path bytes when evidence exists."
    },
    "capture_quality": {
      "$ref": "#/$defs/CaptureQuality",
      "description": "Settlement quality."
    },
    "event_seq": {
      "description": "Responsible canonical event sequence when known.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "frame": {
      "$ref": "#/$defs/ObservationFrame",
      "description": "Compact stable frame."
    },
    "integrity": {
      "$ref": "#/$defs/ObservationIntegrity",
      "description": "Integrity relationship to canonical execution evidence."
    },
    "monotonic_ns": {
      "description": "Session-monotonic timestamp when known.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "payload_hash": {
      "description": "BLAKE3 of canonical JSON for `frame`.",
      "type": "string"
    },
    "presented": {
      "description": "Whether this state was presentation eligible.",
      "type": "boolean"
    },
    "resolution": {
      "$ref": "#/$defs/ObservationResolution",
      "description": "Service path used to resolve this state."
    },
    "session_id": {
      "description": "Canonical session ID when evidence exists.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "source_completed": {
      "description": "Whether canonical execution evidence was durably completed.",
      "type": "boolean"
    },
    "source_kind": {
      "$ref": "#/$defs/ObservationSourceKind",
      "description": "Source category."
    },
    "state_hash": {
      "description": "BLAKE3 of the complete semantic state.",
      "type": "string"
    },
    "state_id": {
      "description": "Semantic state ID when replay assigned one.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "state_point": {
      "$ref": "#/$defs/StatePoint",
      "description": "Requested state point."
    },
    "truth_layer": {
      "$ref": "#/$defs/TruthLayer",
      "description": "Rendering truth layer."
    }
  },
  "required": [
    "source_kind",
    "source_completed",
    "state_point",
    "state_hash",
    "presented",
    "boundary",
    "capture_quality",
    "truth_layer",
    "integrity",
    "resolution",
    "frame",
    "payload_hash"
  ],
  "title": "Observation",
  "type": "object"
}
