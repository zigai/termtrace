{
  "$id": "https://github.com/zigai/termtrace/schemas/state-index-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Compact event/video mapping information for one state.",
  "properties": {
    "checkpoint": {
      "description": "Whether the checkpoint catalog contains an engine checkpoint here.",
      "type": "boolean"
    },
    "event_byte_offset": {
      "description": "Source event byte offset.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "event_seq": {
      "description": "Source event.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "monotonic_ns": {
      "description": "Monotonic state time.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "presented": {
      "description": "Whether a native renderer could present this state.",
      "type": "boolean"
    },
    "state_hash": {
      "description": "State hash.",
      "type": "string"
    },
    "state_id": {
      "description": "State stream position.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "state_id",
    "state_hash",
    "monotonic_ns",
    "presented",
    "checkpoint"
  ],
  "title": "StateIndexEntry",
  "type": "object"
}
