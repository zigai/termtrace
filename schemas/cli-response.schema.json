{
  "$id": "https://github.com/zigai/termtrace/schemas/cli-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "code",
          "applied",
          "retry",
          "session_state"
        ]
      }
    }
  ],
  "description": "Version 1 compact response emitted by --response agent.",
  "properties": {
    "applied": {
      "enum": [
        "none",
        "all",
        "partial",
        "unknown"
      ]
    },
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "response_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "retry": {
      "enum": [
        "not_needed",
        "safe_new_request",
        "same_request_id_only",
        "inspect_before_retry",
        "unsafe"
      ]
    },
    "session_state": {
      "enum": [
        "live",
        "ended",
        "completed",
        "pending",
        "unknown"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "v",
    "ok",
    "type"
  ],
  "title": "Termtrace CLI response",
  "type": "object"
}
