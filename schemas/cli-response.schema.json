{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termtrace.dev/schemas/cli-response.schema.json",
  "title": "Termtrace CLI response",
  "description": "Version 1 compact response emitted by --response agent.",
  "type": "object",
  "required": ["v", "ok", "type"],
  "properties": {
    "v": { "const": 1 },
    "ok": { "type": "boolean" },
    "type": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "applied": { "enum": ["none", "all", "partial", "unknown"] },
    "retry": {
      "enum": [
        "not_needed",
        "safe_new_request",
        "same_request_id_only",
        "inspect_before_retry",
        "unsafe"
      ]
    },
    "session_state": { "enum": ["live", "ended", "completed", "pending", "unknown"] },
    "request_id": { "type": ["string", "integer"] },
    "message": { "type": "string" },
    "truncated": { "type": "boolean" },
    "response_bytes": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "required": ["code", "applied", "retry", "session_state"] }
    }
  ],
  "additionalProperties": true
}
