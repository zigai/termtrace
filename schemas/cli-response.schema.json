{
  "$defs": {
    "Applied": {
      "description": "Mutation application disposition.",
      "oneOf": [
        {
          "const": "none",
          "description": "No mutation was applied.",
          "type": "string"
        },
        {
          "const": "all",
          "description": "The requested mutation was applied in full.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Only part of the requested mutation was applied.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The mutation outcome could not be determined.",
          "type": "string"
        }
      ]
    },
    "Retry": {
      "description": "Authoritative retry guidance.",
      "oneOf": [
        {
          "const": "not_needed",
          "description": "The command does not need to be retried.",
          "type": "string"
        },
        {
          "const": "safe_new_request",
          "description": "A new request may be submitted safely.",
          "type": "string"
        },
        {
          "const": "same_request_id_only",
          "description": "A retry is safe only when it reuses the same request identifier.",
          "type": "string"
        },
        {
          "const": "inspect_before_retry",
          "description": "Inspect current state before deciding whether to retry.",
          "type": "string"
        },
        {
          "const": "unsafe",
          "description": "Retrying may repeat or conflict with the requested operation.",
          "type": "string"
        }
      ]
    },
    "SessionState": {
      "description": "Session lifecycle known at response time.",
      "oneOf": [
        {
          "const": "live",
          "description": "The session is active.",
          "type": "string"
        },
        {
          "const": "ended",
          "description": "The session has ended.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "The session completed successfully.",
          "type": "string"
        },
        {
          "const": "pending",
          "description": "The session lifecycle transition is still pending.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The session lifecycle could not be determined.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/cli-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "code",
          "applied",
          "retry",
          "session_state"
        ]
      }
    }
  ],
  "description": "Version 1 compact response emitted by -A / --agent.",
  "properties": {
    "applied": {
      "$ref": "#/$defs/Applied"
    },
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "response_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "retry": {
      "$ref": "#/$defs/Retry"
    },
    "session_state": {
      "$ref": "#/$defs/SessionState"
    },
    "truncated": {
      "type": "boolean"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    },
    "v": {
      "const": 1
    }
  },
  "required": [
    "v",
    "ok",
    "type"
  ],
  "title": "Termtrace CLI response",
  "type": "object"
}
