{
  "$defs": {
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "ControlCommand": {
      "description": "One command sent to the live session actor.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Verify that the host and protocol are responsive.",
          "properties": {
            "command": {
              "const": "ping",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Return current process and event counters.",
          "properties": {
            "command": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Return the latest presentation-eligible semantic viewport.",
          "properties": {
            "command": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Wait inside the actor for a stable presentation-eligible predicate.",
          "properties": {
            "command": {
              "const": "wait_screen",
              "type": "string"
            },
            "predicate": {
              "$ref": "#/$defs/ScreenPredicate",
              "description": "Exact screen predicate."
            },
            "stable_for_ns": {
              "description": "Required unchanged matching-state interval.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "timeout_ns": {
              "description": "Server-side monotonic deadline interval.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "command",
            "predicate",
            "stable_for_ns",
            "timeout_ns"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Send exact bytes to the child PTY.",
          "properties": {
            "command": {
              "const": "input",
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Raw bytes encoded as Base64 in JSON."
            },
            "input_kind": {
              "$ref": "#/$defs/InputKind",
              "description": "Semantic category retained in the canonical input intent."
            },
            "intent": {
              "description": "Optional human-readable intent.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "data",
            "input_kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Encode and apply one symbolic key against the actor's live terminal modes.",
          "properties": {
            "command": {
              "const": "key",
              "type": "string"
            },
            "key": {
              "$ref": "#/$defs/NamedKey",
              "description": "Layout-independent key."
            },
            "modifiers": {
              "$ref": "#/$defs/KeyModifiers",
              "description": "Typed modifier state."
            }
          },
          "required": [
            "command",
            "key",
            "modifiers"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Paste UTF-8 bytes using the actor's live bracketed-paste mode.",
          "properties": {
            "command": {
              "const": "paste",
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Paste content before mode-dependent wrapping or newline conversion."
            }
          },
          "required": [
            "command",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Report a terminal-window focus transition when the application opted in.",
          "properties": {
            "command": {
              "const": "focus",
              "type": "string"
            },
            "focused": {
              "description": "Whether the terminal gained (`true`) or lost (`false`) focus.",
              "type": "boolean"
            },
            "strict": {
              "description": "Reject instead of returning a semantic no-op when reporting is disabled.",
              "type": "boolean"
            }
          },
          "required": [
            "command",
            "focused",
            "strict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Change the child PTY geometry.",
          "properties": {
            "cols": {
              "description": "Terminal columns.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "command": {
              "const": "resize",
              "type": "string"
            },
            "pixel_height": {
              "description": "Total pixel height.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "pixel_width": {
              "description": "Total pixel width.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "rows": {
              "description": "Terminal rows.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "command",
            "cols",
            "rows",
            "pixel_width",
            "pixel_height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Send one allow-listed signal to the child process group.",
          "properties": {
            "command": {
              "const": "signal",
              "type": "string"
            },
            "signal": {
              "$ref": "#/$defs/ProcessSignal",
              "description": "Signal to send."
            }
          },
          "required": [
            "command",
            "signal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Add a named point to the canonical event stream.",
          "properties": {
            "command": {
              "const": "mark",
              "type": "string"
            },
            "label": {
              "description": "Non-empty marker label.",
              "type": "string"
            }
          },
          "required": [
            "command",
            "label"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Request graceful child termination.",
          "properties": {
            "command": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "InputKind": {
      "description": "User-facing interpretation of an input byte sequence.",
      "oneOf": [
        {
          "const": "raw",
          "description": "Uninterpreted bytes.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Typed textual content.",
          "type": "string"
        },
        {
          "const": "keys",
          "description": "One or more symbolic keyboard keys.",
          "type": "string"
        },
        {
          "const": "paste",
          "description": "Pasted content.",
          "type": "string"
        },
        {
          "const": "focus",
          "description": "Terminal-window focus transition.",
          "type": "string"
        }
      ]
    },
    "KeyModifiers": {
      "description": "Typed modifier state for one semantic key event.",
      "properties": {
        "alt": {
          "description": "Alt modifier.",
          "type": "boolean"
        },
        "control": {
          "description": "Control modifier.",
          "type": "boolean"
        },
        "shift": {
          "description": "Shift modifier.",
          "type": "boolean"
        },
        "super_key": {
          "description": "Super modifier.",
          "type": "boolean"
        }
      },
      "required": [
        "shift",
        "control",
        "alt",
        "super_key"
      ],
      "type": "object"
    },
    "NamedKey": {
      "description": "Layout-independent key accepted by the pinned terminal key encoder.",
      "oneOf": [
        {
          "const": "enter",
          "description": "Enter/Return terminal key (distinct from raw line feed).",
          "type": "string"
        },
        {
          "const": "escape",
          "description": "Escape key.",
          "type": "string"
        },
        {
          "const": "tab",
          "description": "Horizontal tab key.",
          "type": "string"
        },
        {
          "const": "backspace",
          "description": "Backspace key.",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "Forward delete key.",
          "type": "string"
        },
        {
          "const": "insert",
          "description": "Insert key.",
          "type": "string"
        },
        {
          "const": "home",
          "description": "Home key.",
          "type": "string"
        },
        {
          "const": "end",
          "description": "End key.",
          "type": "string"
        },
        {
          "const": "page_up",
          "description": "Page-up key.",
          "type": "string"
        },
        {
          "const": "page_down",
          "description": "Page-down key.",
          "type": "string"
        },
        {
          "const": "arrow_up",
          "description": "Up arrow.",
          "type": "string"
        },
        {
          "const": "arrow_down",
          "description": "Down arrow.",
          "type": "string"
        },
        {
          "const": "arrow_left",
          "description": "Left arrow.",
          "type": "string"
        },
        {
          "const": "arrow_right",
          "description": "Right arrow.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Function key numbered 1 through 24.",
          "properties": {
            "function": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "ASCII letter used for Ctrl+A through Ctrl+Z.",
          "properties": {
            "letter": {
              "maxLength": 1,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "letter"
          ],
          "type": "object"
        }
      ]
    },
    "ProcessSignal": {
      "description": "Safely supported process-group signals.",
      "oneOf": [
        {
          "const": "interrupt",
          "description": "Interrupt the foreground application (`SIGINT`).",
          "type": "string"
        },
        {
          "const": "terminate",
          "description": "Request graceful termination (`SIGTERM`).",
          "type": "string"
        },
        {
          "const": "hangup",
          "description": "Notify the application that its terminal disconnected (`SIGHUP`).",
          "type": "string"
        },
        {
          "const": "user1",
          "description": "Application-defined signal one (`SIGUSR1`).",
          "type": "string"
        },
        {
          "const": "user2",
          "description": "Application-defined signal two (`SIGUSR2`).",
          "type": "string"
        }
      ]
    },
    "ScreenPredicate": {
      "description": "Exact predicate evaluated against the latest presented viewport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Viewport text contains an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "contains",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Viewport text excludes an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "absent",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/control-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request envelope carried as one JSON line.",
  "properties": {
    "command": {
      "$ref": "#/$defs/ControlCommand",
      "description": "Requested operation."
    },
    "expected_presented_state_hash": {
      "description": "Optional optimistic guard over the actor's latest presented state.",
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "description": "Caller-generated correlation identifier.",
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "Protocol version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "request_id",
    "command"
  ],
  "title": "ControlRequest",
  "type": "object"
}
