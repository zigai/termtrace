{
  "$defs": {
    "ArtifactProvenance": {
      "description": "Product provenance, with presentation explicitly retaining its source truth.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Semantic reconstruction, not original pixels.",
          "properties": {
            "kind": {
              "const": "semantic_rendering",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native replay pixels, not original execution.",
          "properties": {
            "kind": {
              "const": "native_replay",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Original execution capture.",
          "properties": {
            "kind": {
              "const": "original_execution",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Derived presentation; authoritative mapping remains in its manifest.",
          "properties": {
            "kind": {
              "const": "presentation_output",
              "type": "string"
            },
            "source_kind": {
              "$ref": "#/$defs/ArtifactSourceKind",
              "description": "Truth of the input to presentation."
            }
          },
          "required": ["kind", "source_kind"],
          "type": "object"
        }
      ]
    },
    "ArtifactRelativePath": {
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      },
      "pattern": "^[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$",
      "type": "string"
    },
    "ArtifactSensitivity": {
      "description": "Sensitivity classification for one derived artifact member.",
      "oneOf": [
        {
          "const": "sensitive_terminal_data",
          "description": "Member contains or may reveal terminal content.",
          "type": "string"
        },
        {
          "const": "operational_metadata",
          "description": "Member contains only non-content operational metadata.",
          "type": "string"
        }
      ]
    },
    "ArtifactSourceKind": {
      "description": "Non-derived source truth; not a replacement for manifest truth-layer strings.",
      "oneOf": [
        {
          "const": "semantic_rendering",
          "description": "Reconstructed terminal state rendered semantically.",
          "type": "string"
        },
        {
          "const": "native_replay",
          "description": "Pixels rendered while replaying canonical evidence.",
          "type": "string"
        },
        {
          "const": "original_execution",
          "description": "Pixels captured during the original execution.",
          "type": "string"
        }
      ]
    },
    "ArtifactSourceRef": {
      "additionalProperties": false,
      "description": "Binding to canonical source; no frame-exact original-capture correlation implied.",
      "properties": {
        "boundary": {
          "$ref": "#/$defs/SdkCanonicalBoundary",
          "description": "Exact canonical prefix (header hash at sequence zero)."
        },
        "session_id": {
          "description": "Canonical session UUID.",
          "format": "uuid",
          "type": "string"
        },
        "session_manifest_hash": {
          "description": "Hash of the source session manifest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": ["session_id", "session_manifest_hash", "boundary"],
      "type": "object"
    },
    "DecimalU64": {
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string",
      "x-termtrace-native-integer": "uint64"
    },
    "DerivativeFormat": {
      "description": "Fixed opaque delivery policies; no transparency or misleading lossless options.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Global 256-color palette, ordered Bayer scale 5, full opaque frames.",
          "properties": {
            "format": {
              "const": "gif",
              "type": "string"
            },
            "loop": {
              "$ref": "#/$defs/GifLoop",
              "default": "infinite",
              "description": "Explicit loop policy."
            }
          },
          "required": ["format"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "VP9 CRF 32, zero bitrate, single thread, limited-range YUV420 BT.709 matrix.",
          "properties": {
            "format": {
              "const": "webm",
              "type": "string"
            }
          },
          "required": ["format"],
          "type": "object"
        }
      ]
    },
    "DerivativeOutput": {
      "additionalProperties": false,
      "description": "Actual encoder facts, not the legacy plan's H.264 delivery settings.",
      "properties": {
        "blake3": {
          "description": "Exact bytes hash.",
          "type": "string"
        },
        "delivery": {
          "$ref": "#/$defs/DerivativeFormat",
          "description": "Effective output and loop policy."
        },
        "frame_count": {
          "$ref": "#/$defs/DecimalU64",
          "description": "Decode-verified number of frames."
        },
        "path": {
          "description": "Relative member path.",
          "type": "string"
        },
        "probe": {
          "description": "Explicit-path ffprobe evidence (including time base/color facts)."
        }
      },
      "required": ["delivery", "path", "blake3", "frame_count", "probe"],
      "type": "object"
    },
    "GifLoop": {
      "description": "A GIF loop is either infinite or absent (play once).",
      "oneOf": [
        {
          "const": "infinite",
          "description": "Netscape loop extension with count zero.",
          "type": "string"
        },
        {
          "const": "once",
          "description": "No loop extension.",
          "type": "string"
        }
      ]
    },
    "NullableString": {
      "type": ["string", "null"]
    },
    "SdkArtifactMember": {
      "additionalProperties": false,
      "description": "Portable member metadata. Canonical `ArtifactMember` serialization is unchanged.",
      "properties": {
        "blake3": {
          "description": "Whole-file BLAKE3.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "byte_length": {
          "$ref": "#/$defs/DecimalU64",
          "description": "Exact bytes in the complete file."
        },
        "media_type": {
          "description": "MIME type.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/ArtifactRelativePath",
          "description": "Relative filename."
        },
        "relationship": {
          "description": "Existing manifest relationship.",
          "type": "string"
        },
        "schema_type": {
          "$ref": "#/$defs/NullableString",
          "description": "Schema identifier, or explicit null."
        },
        "sensitivity": {
          "$ref": "#/$defs/ArtifactSensitivity",
          "description": "Existing sensitivity contract."
        }
      },
      "required": [
        "path",
        "byte_length",
        "blake3",
        "media_type",
        "schema_type",
        "sensitivity",
        "relationship"
      ],
      "type": "object"
    },
    "SdkCanonicalBoundary": {
      "additionalProperties": false,
      "description": "Exact canonical boundary with portable wide integers.",
      "properties": {
        "event_hash": {
          "description": "Prior event hash, or the event header hash at sequence zero.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "next_event_seq": {
          "$ref": "#/$defs/DecimalU64",
          "description": "Sequence assigned to the next event."
        },
        "output_bytes": {
          "$ref": "#/$defs/DecimalU64",
          "description": "Canonical PTY bytes through this boundary."
        }
      },
      "required": ["next_event_seq", "event_hash", "output_bytes"],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/derivative-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Separately versioned multi-delivery presentation manifest.",
  "properties": {
    "color_policy": {
      "description": "Explicit, honest source RGB/color conversion assumptions.",
      "type": "string"
    },
    "commands": {
      "description": "All direct ffmpeg command vectors, in execution order.",
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "array"
    },
    "composition_blake3": {
      "description": "Hash of the private lossless RGB composition used by all deliveries.",
      "type": "string"
    },
    "edit_plan_hash": {
      "description": "Common normalized edit identity.",
      "type": "string"
    },
    "ffmpeg_version": {
      "description": "Pinned tool build report.",
      "type": "string"
    },
    "ffprobe_version": {
      "description": "Probe build report.",
      "type": "string"
    },
    "fps": {
      "description": "Effective frame rate, in frames per second.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "frame_count": {
      "$ref": "#/$defs/DecimalU64",
      "description": "Output count, including all identical and hold frames."
    },
    "gif_policy": {
      "description": "Palette and timing policy, including viewer clamping caveat.",
      "type": "string"
    },
    "height": {
      "description": "Even padded canvas height in pixels.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "members": {
      "description": "Complete non-manifest payload (no self hash).",
      "items": {
        "$ref": "#/$defs/SdkArtifactMember"
      },
      "type": "array"
    },
    "normalized_plan_blake3": {
      "description": "Common normalized plan member hash.",
      "type": "string"
    },
    "outputs": {
      "description": "Per-format actual delivery facts.",
      "items": {
        "$ref": "#/$defs/DerivativeOutput"
      },
      "type": "array"
    },
    "presentation_map_blake3": {
      "description": "Common mapping member hash.",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance",
      "description": "Always `presentation_output` with the verified input truth."
    },
    "source": {
      "$ref": "#/$defs/ArtifactSourceRef",
      "description": "Verified canonical source boundary."
    },
    "source_identity_hash": {
      "description": "Pixel/profile source identity.",
      "type": "string"
    },
    "source_provenance_blake3": {
      "description": "Hash of that exact snapshot (profile policy and tool provenance retained).",
      "type": "string"
    },
    "source_provenance_path": {
      "description": "Relative snapshot of the input capture/semantic provenance manifest.",
      "type": "string"
    },
    "version": {
      "description": "Exactly 1.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "width": {
      "description": "Even padded canvas width in pixels.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "source",
    "provenance",
    "edit_plan_hash",
    "source_identity_hash",
    "source_provenance_path",
    "source_provenance_blake3",
    "composition_blake3",
    "normalized_plan_blake3",
    "presentation_map_blake3",
    "fps",
    "width",
    "height",
    "frame_count",
    "color_policy",
    "gif_policy",
    "ffmpeg_version",
    "ffprobe_version",
    "commands",
    "outputs",
    "members"
  ],
  "title": "DerivativeManifest",
  "type": "object"
}
