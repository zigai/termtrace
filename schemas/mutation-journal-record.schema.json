{
  "$defs": {
    "ActorBoundaries": {
      "additionalProperties": false,
      "description": "Durable and latest actor-processed positions returned by live operations.",
      "properties": {
        "durable": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary whose file synchronization completed successfully."
        },
        "observed": {
          "$ref": "#/$defs/CanonicalBoundary",
          "description": "Latest boundary processed by the session actor, possibly volatile."
        }
      },
      "required": [
        "durable",
        "observed"
      ],
      "type": "object"
    },
    "Base64Bytes": {
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "CanonicalBoundary": {
      "additionalProperties": false,
      "description": "Actor-consistent position in the canonical event stream.",
      "properties": {
        "event_hash": {
          "description": "Hash of the preceding event, or the event header at sequence zero.",
          "type": "string"
        },
        "next_event_seq": {
          "description": "Sequence number that will be assigned to the next event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "PTY output bytes included through this boundary.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "next_event_seq",
        "event_hash",
        "output_bytes"
      ],
      "type": "object"
    },
    "ControlData": {
      "description": "Successful response payload.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No additional data is required.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed canonical positions after the operation."
            },
            "kind": {
              "const": "acknowledged",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact result of one applied input operation.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed positions after application."
            },
            "bytes_written": {
              "description": "Number of bytes written completely.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact bytes emitted by the actor."
            },
            "input_kind": {
              "$ref": "#/$defs/InputKind",
              "description": "Semantic input category."
            },
            "intent_event_seq": {
              "description": "Canonical intent event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "input_applied",
              "type": "string"
            },
            "operation_id": {
              "description": "Canonical operation identifier (the caller request ID).",
              "format": "uuid",
              "type": "string"
            },
            "result_event_seq": {
              "description": "Canonical result event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "operation_id",
            "input_kind",
            "data",
            "bytes_written",
            "intent_event_seq",
            "result_event_seq",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Successful semantic input request that correctly emitted no bytes.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed positions at evaluation."
            },
            "input_kind": {
              "$ref": "#/$defs/InputKind",
              "description": "Semantic input category."
            },
            "kind": {
              "const": "input_noop",
              "type": "string"
            },
            "reason": {
              "description": "Stable explanation for the no-op.",
              "type": "string"
            },
            "terminal_modes_hash": {
              "description": "BLAKE3 of canonical JSON for the terminal mode snapshot.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input_kind",
            "reason",
            "terminal_modes_hash",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact result of one semantic text activation.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed positions after application."
            },
            "bytes_written": {
              "description": "Number of bytes written completely.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "data": {
              "$ref": "#/$defs/Base64Bytes",
              "description": "Exact bytes emitted by the actor."
            },
            "end_column": {
              "description": "Zero-based exclusive matched column.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "intent_event_seq": {
              "description": "Canonical intent event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "activated",
              "type": "string"
            },
            "operation_id": {
              "description": "Canonical operation identifier.",
              "format": "uuid",
              "type": "string"
            },
            "presented_state_hash": {
              "description": "Presented-state hash used for resolution and encoding.",
              "type": "string"
            },
            "result_event_seq": {
              "description": "Canonical result event sequence.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "row": {
              "description": "Zero-based matched row.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "start_column": {
              "description": "Zero-based first matched column.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "target_column": {
              "description": "Cell chosen for the click.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "Exact matched text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "operation_id",
            "text",
            "start_column",
            "end_column",
            "row",
            "target_column",
            "presented_state_hash",
            "data",
            "bytes_written",
            "intent_event_seq",
            "result_event_seq",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Live session status.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed canonical positions at status evaluation."
            },
            "kind": {
              "const": "status",
              "type": "string"
            },
            "pid": {
              "description": "Child process identifier when available.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Observer-only latest presented terminal state.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed source boundaries at observation time."
            },
            "cols": {
              "description": "Terminal columns.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "cursor_column": {
              "description": "Cursor column when it lies in the viewport.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "cursor_row": {
              "description": "Cursor row when it lies in the viewport.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "cursor_visible": {
              "description": "Whether the cursor is visible.",
              "type": "boolean"
            },
            "kind": {
              "const": "snapshot",
              "type": "string"
            },
            "modes": {
              "$ref": "#/$defs/ModeState",
              "description": "Presentation-eligible terminal modes."
            },
            "observed_monotonic_ns": {
              "description": "Session-monotonic observation timestamp.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "presented": {
              "description": "Always true for this presentation-filtered endpoint.",
              "type": "boolean"
            },
            "rows": {
              "description": "Terminal rows.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "state_hash": {
              "description": "BLAKE3 of canonical JSON for `state`.",
              "type": "string"
            },
            "viewport_text": {
              "description": "Plain text of the presentation-eligible viewport.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "viewport_text",
            "state_hash",
            "presented",
            "cols",
            "rows",
            "cursor_visible",
            "observed_monotonic_ns",
            "modes",
            "boundaries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Successful server-side presented-screen wait.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Actor-consistent canonical source boundaries."
            },
            "cols": {
              "description": "Terminal columns.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "completion_quality": {
              "description": "`stable` or `matched_unsettled`.",
              "type": "string"
            },
            "first_match_monotonic_ns": {
              "description": "First matching timestamp for this unchanged state.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "screen_wait",
              "type": "string"
            },
            "predicate": {
              "$ref": "#/$defs/ScreenPredicate",
              "description": "Predicate that matched."
            },
            "rows": {
              "description": "Terminal rows.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "stable_for_ns": {
              "description": "Requested unchanged interval.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stable_through_monotonic_ns": {
              "description": "Last timestamp through which the state remained stable.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state_hash": {
              "description": "Full presentation-eligible semantic state hash.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "predicate",
            "state_hash",
            "first_match_monotonic_ns",
            "stable_through_monotonic_ns",
            "stable_for_ns",
            "boundaries",
            "cols",
            "rows",
            "completion_quality"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Canonical position of an appended marker.",
          "properties": {
            "boundaries": {
              "$ref": "#/$defs/ActorBoundaries",
              "description": "Durable and observed canonical positions after the marker."
            },
            "event_seq": {
              "description": "Canonical event sequence containing the marker.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "marked",
              "type": "string"
            },
            "label": {
              "description": "Normalized marker label.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label",
            "event_seq",
            "boundaries"
          ],
          "type": "object"
        }
      ]
    },
    "ControlErrorDetails": {
      "additionalProperties": false,
      "description": "Structured context attached to an optimistic-concurrency rejection.",
      "properties": {
        "boundaries": {
          "$ref": "#/$defs/ActorBoundaries",
          "description": "Durable and observed source positions used for the comparison."
        },
        "current_presented_state_hash": {
          "description": "Latest presented-state hash at the actor ordering point.",
          "type": "string"
        },
        "scope": {
          "description": "Exact output scope covered by the state comparison.",
          "type": "string"
        }
      },
      "required": [
        "current_presented_state_hash",
        "boundaries",
        "scope"
      ],
      "type": "object"
    },
    "ControlResponse": {
      "additionalProperties": false,
      "description": "Response envelope carried as one JSON line.",
      "properties": {
        "request_id": {
          "description": "Identifier copied from the request.",
          "format": "uuid",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ControlResult",
          "description": "Success or structured rejection."
        },
        "version": {
          "description": "Protocol version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "request_id",
        "result"
      ],
      "type": "object"
    },
    "ControlResult": {
      "description": "Successful response or stable rejection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Command was accepted and completely applied.",
          "properties": {
            "data": {
              "$ref": "#/$defs/ControlData",
              "description": "Command-specific data."
            },
            "status": {
              "const": "ok",
              "type": "string"
            }
          },
          "required": [
            "status",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Command was rejected or failed.",
          "properties": {
            "code": {
              "description": "Stable machine-readable code.",
              "type": "string"
            },
            "details": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ControlErrorDetails"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Actor-consistent context for a rejected optimistic guard."
            },
            "message": {
              "description": "Human-readable diagnostic.",
              "type": "string"
            },
            "status": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "status",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "InputKind": {
      "description": "User-facing interpretation of an input byte sequence.",
      "oneOf": [
        {
          "const": "raw",
          "description": "Uninterpreted bytes.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Typed textual content.",
          "type": "string"
        },
        {
          "const": "keys",
          "description": "One or more symbolic keyboard keys.",
          "type": "string"
        },
        {
          "const": "paste",
          "description": "Pasted content.",
          "type": "string"
        },
        {
          "const": "focus",
          "description": "Terminal-window focus transition.",
          "type": "string"
        },
        {
          "const": "pointer",
          "description": "Cell-addressed mouse or wheel operation.",
          "type": "string"
        }
      ]
    },
    "ModeState": {
      "description": "Terminal modes relevant to presentation and input.",
      "properties": {
        "alternate_screen": {
          "description": "Any alternate-screen mode.",
          "type": "boolean"
        },
        "bracketed_paste": {
          "description": "DEC bracketed-paste mode 2004.",
          "type": "boolean"
        },
        "synchronized_output": {
          "description": "DEC synchronized-output mode 2026.",
          "type": "boolean"
        },
        "values": {
          "description": "Complete stable inventory of known ANSI and DEC modes.",
          "items": {
            "$ref": "#/$defs/TerminalMode"
          },
          "type": "array"
        },
        "wraparound": {
          "description": "DEC auto-wrap mode 7.",
          "type": "boolean"
        }
      },
      "required": [
        "synchronized_output",
        "alternate_screen",
        "wraparound",
        "bracketed_paste",
        "values"
      ],
      "type": "object"
    },
    "ScreenPredicate": {
      "description": "Exact predicate evaluated against the latest presented viewport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Viewport text contains an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "contains",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Viewport text excludes an exact UTF-8 substring.",
          "properties": {
            "predicate": {
              "const": "absent",
              "type": "string"
            },
            "text": {
              "description": "Exact UTF-8 substring.",
              "type": "string"
            }
          },
          "required": [
            "predicate",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "TerminalMode": {
      "description": "One ANSI or DEC mode value.",
      "properties": {
        "ansi": {
          "description": "`true` for ANSI mode, `false` for DEC-private mode.",
          "type": "boolean"
        },
        "enabled": {
          "description": "Current set/reset value.",
          "type": "boolean"
        },
        "number": {
          "description": "Numeric mode identifier.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "number",
        "ansi",
        "enabled"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/zigai/termtrace/schemas/mutation-journal-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One durable mutation request outcome tied to a canonical event boundary.",
  "properties": {
    "command_hash": {
      "description": "BLAKE3 of the normalized serialized control command.",
      "type": "string"
    },
    "event_end_seq": {
      "description": "Exclusive next-event boundary after command execution.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "event_hash": {
      "description": "Canonical event hash at `event_end_seq`.",
      "type": "string"
    },
    "event_start_seq": {
      "description": "Inclusive next-event boundary before command execution.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "format": {
      "description": "Stable record format identifier.",
      "type": "string"
    },
    "hash": {
      "description": "Hash of this record body.",
      "type": "string"
    },
    "operation_ids": {
      "description": "Canonical operation identifiers created by the request.",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    },
    "prev_hash": {
      "description": "Prior journal record hash, or 64 zeroes for the first record.",
      "type": "string"
    },
    "request_id": {
      "description": "Caller-owned mutation request identifier.",
      "format": "uuid",
      "type": "string"
    },
    "response": {
      "$ref": "#/$defs/ControlResponse",
      "description": "Exact actor response returned for safe retry."
    },
    "seq": {
      "description": "Contiguous zero-based journal sequence.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "description": "Record schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "seq",
    "prev_hash",
    "hash",
    "request_id",
    "command_hash",
    "operation_ids",
    "event_start_seq",
    "event_end_seq",
    "event_hash",
    "response"
  ],
  "title": "MutationJournalRecord",
  "type": "object"
}
