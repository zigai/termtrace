+
+#include <sys/types.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "tmux.h"
+#include "pane-launch.h"
+
+/* Called in the child after tmux has prepared its terminal and environment. */
+void
+pane_launch(struct session *s, struct window_pane *wp)
+{
+	const char	 *command, *mode;
+	char		**argv;
+	int		  i;
+
+	command = options_get_string(s->options, "pane-launch-command");
+	if (*command == '\0')
+		return;
+	if (wp->argc == 0)
+		mode = "login";
+	else if (wp->argc == 1)
+		mode = "shell";
+	else
+		mode = "exec";
+
+	/* Original arguments are never interpolated into shell source. */
+	argv = xcalloc((size_t)wp->argc + 7, sizeof *argv);
+	argv[0] = (char *)"/bin/sh";
+	argv[1] = (char *)"-c";
+	argv[2] = (char *)command;
+	argv[3] = (char *)"pane-launch";
+	argv[4] = (char *)mode;
+	argv[5] = wp->shell;
+	for (i = 0; i < wp->argc; i++)
+		argv[i + 6] = wp->argv[i];
+	execv(argv[0], argv);
+	perror("pane-launch-command");
+	_exit(1);
+}
