#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ "$1" != "+show-config" ]]; then
    echo "the headless Ghostty fixture supports only +show-config" >&2
    exit 2
fi

config_home=${XDG_CONFIG_HOME:-"${HOME:?}/.config"}
config="$config_home/ghostty/config.ghostty"
if [[ -f "$config" ]]; then
    cat "$config"
fi
